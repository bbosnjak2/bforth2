              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
0183:         	is_whitespace:
0183: FE20    	    CP      A, ASCII_SPACE
0185: C8      	    RET     Z
              	
0186: FE09    	    CP      A, ASCII_TAB
0188: C8      	    RET     Z
              	
0189: FE0D    	    CP      A, ASCII_CR
018B: C8      	    RET     Z
              	
018C: FE0A    	    CP      A, ASCII_LF
018E: C8      	    RET     Z
              	
018F: FE0C    	    CP      A, ASCII_FF
0191: C8      	    RET     Z
              	
0192: FE0B    	    CP      A, ASCII_VT
0194: C8      	    RET     Z
              	
0195: C9      	    RET
              	    
