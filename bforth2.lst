06EB: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
06EE: CD3208  	    CALL    push_string
              	
06F1: CDFC06  	    CALL    DOT
              	
06F4: C9      	    RET
              	
