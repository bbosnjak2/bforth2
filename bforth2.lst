0893: 20656D70	
0897: 74792E5C	
089B: 6E24    	
              	    .endlocal
              	
089D:         	stack_concatenate_execute:
089D: DD2AA30D	    LD      IX, (STACK_POINTER)             ; second string
              	
08A1: 2AA30D  	    LD      HL, (STACK_POINTER)
08A4: DD4E01  	    LD      BC, (IX + 1)                    ; string length
08A7: DD4602  	
08AA: 09      	    ADD     HL, BC
              	
08AB: 010300  	    LD      BC, 0x0003                      ; header length
08AE: 09      	    ADD     HL, BC
              	
08AF: E5      	    PUSH    HL
08B0: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
08B2: ED5BA30D	    LD      DE, (STACK_POINTER)
08B6: 1B      	    DEC     DE
              	
              	; copy the second word
08B7: DD4E01  	    LD      BC, (IX + 1)                    ; count
08BA: DD4602  	
08BD: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
08BF: E1      	    POP     HL
08C0: 09      	    ADD     HL, BC
08C1: 23      	    INC     HL
08C2: 23      	    INC     HL
              	
08C3: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
08C5: FD4E01  	    LD      BC, (IY + 1)                    ; count
08C8: FD4602  	
08CB: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
08CD: E1      	    POP     HL
08CE: 09      	    ADD     HL, BC
08CF: 23      	    INC     HL
08D0: 23      	    INC     HL
              	
08D1: EDB8    	    LDDR                                    ; copy second word down
              	
08D3: 13      	    INC     DE                              ; point to the start of the new string
              	
08D4: DD6E01  	    LD      HL, (IX + 1)
08D7: DD6602  	
08DA: FD4E01  	    LD      BC, (IY + 1)
08DD: FD4602  	
08E0: 09      	    ADD     HL, BC
08E1: 444D    	    LD      BC, HL                          ; combined length
              	
08E3: D9      	    EXX
08E4: CD4408  	    CALL    pop_stack
08E7: CD4408  	    CALL    pop_stack
08EA: D9      	    EXX
              	
08EB: CD2E08  	    CALL    push_string
              	
08EE: C9      	    RET
              	    
              	
