099B: FD4602  	
099E: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
09A0: E1      	    POP     HL
09A1: 09      	    ADD     HL, BC
09A2: 23      	    INC     HL
09A3: 23      	    INC     HL
              	
09A4: EDB8    	    LDDR                                    ; copy second word down
              	
09A6: 13      	    INC     DE                              ; point to the start of the new string
              	
09A7: DD6E01  	    LD      HL, (IX + 1)
09AA: DD6602  	
09AD: FD4E01  	    LD      BC, (IY + 1)
09B0: FD4602  	
09B3: 09      	    ADD     HL, BC
09B4: 444D    	    LD      BC, HL                          ; combined length
              	
09B6: D9      	    EXX
09B7: CD1709  	    CALL    pop_stack
09BA: CD1709  	    CALL    pop_stack
09BD: D9      	    EXX
              	
