0907: CDC007  	    CALL    print
090A: 112701  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
090D: CDC007  	    CALL    print
0910: C9      	    RET
              	
0911:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
