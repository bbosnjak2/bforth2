09FE: DD2A340F	    LD      IX, (WORD_LIST_NEXT)
              	
0A02: 78      	    LD      A, B                            ; write the number of characters (excludes the null terminator)
0A03: DD7700  	    LD      (IX + 0), A
              	
0A06: 2A320F  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
0A09: DD7501  	    LD      (IX + 1), HL
0A0C: DD7402  	
              	
0A0F: C5      	    PUSH    BC                              ; save the number of characters value that's in B
              	
0A10: 2A340F  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
