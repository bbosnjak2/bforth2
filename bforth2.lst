              	    .include "output/clear-screen.cpm.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0730:         	clear_screen
0730: 113907  	    LD      DE, CLEAR_SCREEN_SEQ
0733: 0E09    	    LD      C, $09
0735: CD0500  	    CALL    $0005
              	
0738: C9      	    RET
              	
0739:         	CLEAR_SCREEN_SEQ    DEFL    $
0739: 1B      	    .byte   27
073A: 5B324A  	    .ascii  "[2J"
073D: 1B      	    .byte   27
073E: 5B48    	    .ascii  "[H"
0740: 24      	    .ascii  "$"
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
0741:         	print:
0741: 1A      	    LD      A, (DE)
0742: B7      	    OR      A
0743: C8      	    RET     Z                               ; nothing to print
              	
0744: 3E00    	    LD      A, $00                          ; null terminator
0746: 62      	    LD      H, D                            ; copy the start address in HL
0747: 6B      	    LD      L, E
              	
0748:         	print_find_null_terminator_loop:
0748: EDA1    	    CPI                                     ; compare (HL) to a null terminator
074A: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
074C: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
074D: 3E24    	    LD      A, '$'
074F: 77      	    LD      (HL), A
              	
0750: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
0751: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0753: CD0500  	    CALL    $0005
              	
0756: E1      	    POP     HL                              ; restore HL and put the null terminator back
0757: 3E00    	    LD      A, $00
0759: 77      	    LD      (HL), A
              	
075A: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
075B:         	print_char:
075B: 5F      	    LD      E, A
075C: 0E02    	    LD      C, F_CONSOLE_OUT
075E: CD0500  	    CALL    BDOS
              	
0761: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
0762:         	prompt
              	    .local
0762: 116F07  	    LD      DE, INPUT_PROMPT
0765: 010200  	    LD      BC, 0x02
0768: CDC807  	    CALL    push_string
              	
076B: CD4107  	    CALL    print
              	
076E: C9      	    RET
              	
076F: 3E20    	INPUT_PROMPT        DEFM    "> "
              	    .endlocal
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0771:         	clear_input_buffer
0771: 21960C  	    LD      HL, INPUT_BUFFER
0774: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
0777: 3E00    	    LD      A, 0x00
              	
0779: CD9101  	    CALL    fill_memory
              	
077C: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
077D:         	load_input_buffer
077D: CD7107  	    CALL    clear_input_buffer
              	
0780: 11940C  	    LD      DE, INPUT_BUFFER_SIZE
0783: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0785: 12      	    LD      (DE), A
              	
0786: 0E0A    	    LD      C, $0A
0788: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
078B: 1E0A    	    LD      E, ASCII_LF
078D: 0E02    	    LD      C, $02
078F: CD0500  	    CALL    $0005
              	
0792: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0793:         	copy_input_to_current_input:
0793: 21E70C  	    LD      HL, CURRENT_INPUT
0796: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0799: 3E00    	    LD      A, 0x00
079B: CD9101  	    CALL    fill_memory
              	
079E: DD21370D	    LD      IX, CURRENT_INPUT_LEN
              	
07A2: 21960C  	    LD      HL, INPUT_BUFFER                ; source
07A5: 11E70C  	    LD      DE, CURRENT_INPUT               ; destination
07A8: ED53390D	    LD      (CURRENT_INPUT_POS), DE
              	
07AC: 3A950C  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
07AF: 0600    	    LD      B, 0x00
07B1: 4F      	    LD      C, A
07B2: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
07B5: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
07B8: B7      	    OR      A                               ; skip if nothing was input
07B9: 2802    	    JR      Z, copy_input_to_current_input_done
              	
07BB: EDB0    	    LDIR                                    ; copy
              	
07BD:         	copy_input_to_current_input_done:
07BD: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/reset-stack.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07BE:         	reset_stack:
07BE: 2A0600  	    LD      HL, (0x0006)                    ; top of TPA(transient program area) / start of BDOS
07C1: 22900C  	    LD      (STACK_BASE), HL
07C4: 22920C  	    LD      (STACK_POINTER), HL
              	
07C7: C9      	    RET
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
07C8:         	push_string:
07C8: 2A920C  	    LD      HL, (STACK_POINTER)
07CB: ED42    	    SBC     HL, BC
              	
07CD: 2B      	    DEC     HL                              ; 2 bytes for length
07CE: 2B      	    DEC     HL
07CF: 2B      	    DEC     HL                              ; 1 byte for type
              	
07D0: 22920C  	    LD      (STACK_POINTER), HL
              	
07D3: 3601    	    LD      (HL), STACK_STRING_TYPE
07D5: 23      	    INC     HL
              	
07D6: 70      	    LD      (HL), B
07D7: 23      	    INC     HL
07D8: 71      	    LD      (HL), C
07D9: 23      	    INC     HL
              	
07DA: EB      	    EX      DE, HL
07DB: EDB0    	    LDIR
              	
07DD: C9      	    RET
              	    
              	
              	    .include "command-processor/process-current-input.asm"
              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
07DE:         	process_current_input:
07DE: CD3F08  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
07E1: 213C0D  	    LD      HL, CURRENT_TOKEN
07E4: 3A3B0D  	    LD      A, (CURRENT_TOKEN_LEN)
07E7: B7      	    OR      A
07E8: 2817    	    JR      Z, process_current_input_done
              	
07EA: 47      	    LD      B, A
07EB: CDB104  	    CALL    to_uppercase
              	
07EE: CD0208  	    CALL    find_command_method_address
              	
07F1: 280D    	    JR      Z, process_current_input_command_recognized
              	
07F3:         	process_current_input_command_not_recognized:
07F3: 113C0D  	    LD      DE, CURRENT_TOKEN
07F6: CD4107  	    CALL    print
07F9: 116501  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
07FC: CD4107  	    CALL    print
07FF: C9      	    RET
              	
0800:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
0800: E9      	    JP      HL
              	
0801:         	process_current_input_done:
0801: C9      	    RET
              	
              	    .include "find-command-method-address.asm"
              	;; ==================================================================
              	;; Finds the command in CURRENT_COMMAND in the command list.
              	;; IN:  -
              	;; OUT: HL = address of command method
              	;;      Z = set if command found (NZ if not found)
              	;; MOD: A, B, C, HL, DE, IX
              	;; ==========================================================
0802:         	find_command_method_address:
0802: DD21CE04	    LD      IX, COMMAND_LIST
0806: 3A3B0D  	    LD      A, (CURRENT_TOKEN_LEN)
0809: 47      	    LD      B, A
              	
080A:         	find_command_method_address_check_command:
080A: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
080D: B7      	    OR      A                               ; if 0, then end of list reached
080E: 282B    	    JR      Z, find_command_method_address_not_found
              	
0810: B8      	    CP      B                               ; if the length differs, move to the next command
0811: 200E    	    JR      NZ, find_command_method_address_next_command
              	
0813:         	find_command_method_address_compare:
0813: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
0816: DD6604  	
0819: 113C0D  	    LD      DE, CURRENT_TOKEN
081C: 48      	    LD      C, B                            ; number of characters
              	
081D:         	find_command_method_address_compare_loop:
081D: 1A      	    LD      A, (DE)
081E: BE      	    CP      (HL)
081F: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
0821:         	find_command_method_address_next_command:
0821: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
0824: DD6601  	
0827: E5      	    PUSH    HL
0828: DDE1    	    POP     IX
082A: 18DE    	    JR      find_command_method_address_check_command
              	
082C:         	find_command_method_address_compare_next_character:
082C: 23      	    INC     HL
082D: 13      	    INC     DE
082E: 0D      	    DEC     C                               ; move to next character
082F: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
0831:         	find_command_method_address_found:          ; all characters have matched
0831: DD6E09  	    LD      HL, (IX + COMMAND_METHOD_ADDRESS)
0834: DD660A  	
0837: 3E00    	    LD      A, $00
0839: B7      	    OR      A                               ; clears the Z flag
083A: C9      	    RET
              	
083B:         	find_command_method_address_not_found:
083B: 3E01    	    LD      A, $01
083D: B7      	    OR      A                               ; sets the Z flag
              	
083E: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
083F:         	parse_token:
