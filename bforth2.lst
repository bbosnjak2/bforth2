              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0715:         	DOT
0715: 2A2B0E  	    LD      HL, (STACK_BASE)
0718: ED5B2D0E	    LD      DE, (STACK_POINTER)
071C: ED52    	    SBC     HL, DE
071E: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0720: 112807  	    LD      DE, ERROR
0723: 0E09    	    LD      C, $09
0725: C30500  	    JP      $0005
              	
0728: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
072C: 6B206973	
0730: 20656D70	
0734: 74792E5C	
0738: 6E24    	
              	    .endlocal
              	
073A:         	DOT_push_terminator:
              	    .local
073A: 114507  	    LD      DE, TERMINATOR                  ; content
073D: 010100  	    LD      BC, 0x01                        ; length
0740: CD8F09  	    CALL    push_string
0743: 1801    	    JR      DOT_concatenate
              	
0745: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
0746:         	DOT_concatenate:
0746: CDED09  	    CALL    stack_concatenate
              	
