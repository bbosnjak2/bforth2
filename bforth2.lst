09A4: 444D    	    LD      BC, HL                          ; combined length
              	
09A6: D9      	    EXX
09A7: CD0709  	    CALL    pop_stack
09AA: CD0709  	    CALL    pop_stack
09AD: D9      	    EXX
              	
