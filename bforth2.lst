              	;; MOD: A, B, C, HL, DE, IX
              	;; ==========================================================
0906:         	find_command_method_address:
0906: DD21DA04	    LD      IX, COMMAND_LIST
090A: 3A3F0E  	    LD      A, (CURRENT_TOKEN_LEN)
090D: 47      	    LD      B, A
              	
090E:         	find_command_method_address_check_command:
090E: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
0911: B7      	    OR      A                               ; if 0, then end of list reached
0912: 282B    	    JR      Z, find_command_method_address_not_found
              	
0914: B8      	    CP      B                               ; if the length differs, move to the next command
0915: 200E    	    JR      NZ, find_command_method_address_next_command
              	
0917:         	find_command_method_address_compare:
0917: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
091A: DD6604  	
091D: 11400E  	    LD      DE, CURRENT_TOKEN
0920: 48      	    LD      C, B                            ; number of characters
              	
0921:         	find_command_method_address_compare_loop:
0921: 1A      	    LD      A, (DE)
0922: BE      	    CP      (HL)
0923: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
0925:         	find_command_method_address_next_command:
0925: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
0928: DD6601  	
092B: E5      	    PUSH    HL
092C: DDE1    	    POP     IX
092E: 18DE    	    JR      find_command_method_address_check_command
              	
0930:         	find_command_method_address_compare_next_character:
0930: 23      	    INC     HL
0931: 13      	    INC     DE
0932: 0D      	    DEC     C                               ; move to next character
0933: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
