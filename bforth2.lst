094D: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0950: 3E00    	    LD      A, 0x00
0952: CD7509  	    CALL    system_fill_memory
              	
0955: DD21D20E	    LD      IX, CURRENT_INPUT_LEN
              	
0959: 21310E  	    LD      HL, INPUT_BUFFER                ; source
095C: 11820E  	    LD      DE, CURRENT_INPUT               ; destination
095F: ED53D40E	    LD      (CURRENT_INPUT_POS), DE
              	
0963: 3A300E  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
0966: 0600    	    LD      B, 0x00
0968: 4F      	    LD      C, A
0969: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
096C: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
096F: B7      	    OR      A                               ; skip if nothing was input
0970: 2802    	    JR      Z, system_copy_input_to_current_input_done
              	
0972: EDB0    	    LDIR                                    ; copy
              	
