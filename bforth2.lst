              	;; ==================================================================
              	;; Adds a word to the word list.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
09E2:         	add_command:
09E2: 114001  	    LD      DE, NOT_IMPLEMENTED_NL
09E5: C3C007  	    JP      print
              	
09E8: CD5009  	    CALL    parse_token
              	
09EB: 78      	    LD      A, B                            ; check if a word was specified
09EC: B7      	    OR      A
09ED: 283D    	    JR      Z, add_command_syntax_error
              	
09EF: 2A4A0E  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
09F2: 7E      	    LD      A, (HL)
09F3: B7      	    OR      A
09F4: 2036    	    JR      NZ, add_command_syntax_error
              	
09F6:         	add_command_write_word_text:
09F6: DD2A2C0F	    LD      IX, (WORD_LIST_NEXT)
              	
09FA: 78      	    LD      A, B                            ; write the number of characters (excludes the null terminator)
09FB: DD7700  	    LD      (IX + 0), A
              	
09FE: 2A2A0F  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
0A01: DD7501  	    LD      (IX + 1), HL
0A04: DD7402  	
              	
0A07: C5      	    PUSH    BC                              ; save the number of characters value that's in B
              	
0A08: 2A2C0F  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
0A0B: 110500  	    LD      DE, 5                           ; offset HL to the location to write the word itself
0A0E: 19      	    ADD     HL, DE
              	
0A0F: DD7503  	    LD      (IX + 3), HL                    ; update the header with the location where the text will be copied to
0A12: DD7404  	
              	
0A15: EB      	    EX      DE, HL                          ; update DE to be the destination pointed to by HL
0A16: 214D0E  	    LD      HL, CURRENT_TOKEN               ; HL is the source
              	
0A19: 48      	    LD      C, B
0A1A: 0600    	    LD      B, 0x00
0A1C: 03      	    INC     BC                              ; copy the null terminated, too
              	
0A1D: EDB0    	    LDIR                                    ; write the word, DE will be the new WORD_LIST_NEXT value
              	
0A1F: C1      	    POP     BC                              ; restore the number of characters value in B
              	
