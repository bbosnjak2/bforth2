019B: C8      	    RET     Z
              	
019C: FE0D    	    CP      A, ASCII_CR
019E: C8      	    RET     Z
              	
019F: FE0A    	    CP      A, ASCII_LF
01A1: C8      	    RET     Z
              	
01A2: FE0C    	    CP      A, ASCII_FF
01A4: C8      	    RET     Z
              	
01A5: FE0B    	    CP      A, ASCII_VT
01A7: C8      	    RET     Z
              	
01A8: C9      	    RET
              	    
