0ABB: 2A700F  	    LD      HL, (WORD_LIST_NEXT)            ; the head is now what was previously the next location
0ABE: 226E0F  	    LD      (WORD_LIST_HEAD), HL
0AC1: ED53700F	    LD      (WORD_LIST_NEXT), DE            ; the next location is now where DE ended up
              	
0AC5: 1807    	    JR      add_command_done
              	
