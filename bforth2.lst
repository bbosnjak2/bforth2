093F: 3E01    	    LD      A, $01
0941: B7      	    OR      A                               ; sets the Z flag
              	
0942: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
0943:         	parse_token:
0943: DD213B0E	    LD      IX, CURRENT_INPUT_LEN
0947: FD213F0E	    LD      IY, CURRENT_TOKEN_LEN
              	
094B: 21400E  	    LD      HL, CURRENT_TOKEN
094E: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0951: 3E00    	    LD      A, 0x00
0953: FD360000	    LD      (IY), 0x00
0957: CD9D01  	    CALL    fill_memory
              	
095A: 2A3D0E  	    LD      HL, (CURRENT_INPUT_POS)
095D: 11400E  	    LD      DE, CURRENT_TOKEN
              	
0960:         	parse_token_skip_whitespace:
