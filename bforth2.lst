              	    .endlocal
              	    
              	    .include "dictionary/PRINT-GREETING.asm"
              	;; ==========================================================
              	;; Prints the initial greeting
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0799:         	PRINT_GREETING
0799: CD6F08  	    CALL    WELCOME_TEXT
079C: CD0E07  	    CALL    DOT
079F: CD5007  	    CALL    HELP_PROMPT_TEXT
07A2: CD0E07  	    CALL    DOT
07A5: C9      	    RET
              	    
              	    .include "dictionary/PROMPT.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
07A6:         	PROMPT
              	    .local
07A6: 11B307  	    LD      DE, INPUT_PROMPT                ; content
07A9: 010200  	    LD      BC, INPUT_PROMPT_LEN            ; length
07AC: CDFE08  	    CALL    push_string
              	
07AF: CD0E07  	    CALL    DOT
              	
07B2: C9      	    RET
              	
07B3: 3E20    	INPUT_PROMPT     DEFM    "> "
              	
0002:         	INPUT_PROMPT_LEN .equ    $ - INPUT_PROMPT
              	    .endlocal
              	    
              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07B5:         	RESET_STACK
07B5: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
07B8: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
07B9: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
07BC: ED42    	    SBC     HL, BC
              	
07BE: 22270E  	    LD      (STACK_BASE), HL
07C1: 22290E  	    LD      (STACK_POINTER), HL
              	
07C4: C9      	    RET
              	    
              	    .include "dictionary/START.asm"
              	;; ==========================================================
              	;; Starts (or restarts) the system
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07C5:         	START:
07C5: CDB507  	    CALL    RESET_STACK
07C8: CDFA06  	    CALL    CLEAR_SCREEN
07CB: CD9907  	    CALL    PRINT_GREETING
              	
07CE: C9      	    RET
              	    
              	    .include "dictionary/TOKEN.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and pushing it to the stack.  If no token is found then the stack
              	;; entry will have zero length.
              	;; IN:  -
              	;; OUT: -
              	;; MOD:
              	;; ==================================================================
07CF:         	TOKEN:
07CF: DD21CE0E	    LD      IX, CURRENT_INPUT_LEN
07D3: FD211E08	    LD      IY, CURRENT_TOKEN_LEN
              	
07D7: 211F08  	    LD      HL, CURRENT_TOKEN
07DA: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07DD: 3E00    	    LD      A, 0x00
07DF: FD360000	    LD      (IY), 0x00
07E3: CDE408  	    CALL    system_fill_memory
              	
07E6: 2AD00E  	    LD      HL, (CURRENT_INPUT_POS)
07E9: 111F08  	    LD      DE, CURRENT_TOKEN
              	
07EC:         	TOKEN_skip_whitespace:
07EC: DD7E01  	    LD      A, (IX + 1)                     ; CURRENT_INPUT_REMAINING_LEN
07EF: B7      	    OR      A
07F0: 281D    	    JR      Z, TOKEN_end_of_input
              	
07F2: 7E      	    LD      A, (HL)
              	
07F3: CD5B01  	    CALL    is_whitespace
07F6: 2006    	    JR      NZ, TOKEN_copy_token_loop
              	
07F8: 23      	    INC     HL
07F9: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
07FC: 18EE    	    JR      TOKEN_skip_whitespace
              	
07FE:         	TOKEN_copy_token_loop:
07FE: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
07FF: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0802: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0803: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
0806: 2807    	    JR      Z, TOKEN_end_of_token
              	
0808: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
0809: 7E      	    LD      A, (HL)                         ; load the next character
080A: CD5B01  	    CALL    is_whitespace
080D: 20EF    	    JR      NZ, TOKEN_copy_token_loop
              	
080F:         	TOKEN_end_of_input:
080F:         	TOKEN_end_of_token:
080F: 22D00E  	    LD      (CURRENT_INPUT_POS), HL
              	
0812:         	TOKEN_done:
0812: FD4E00  	    LD      C, (IY)                         ; CURRENT_INPUT_LEN
0815: 0600    	    LD      B, 0
0817: 111F08  	    LD      DE, CURRENT_TOKEN
081A: CDFE08  	    CALL    push_string
              	
081D: C9      	    RET
              	
081E: 00      	CURRENT_TOKEN_LEN DEFB    0
081F: 00000000	CURRENT_TOKEN     DEFS    (CURRENT_INPUT_MAX_LEN), 0
0823: 00...   	
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
