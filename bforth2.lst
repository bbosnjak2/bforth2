              	    .include "dictionary/CLEAR.asm"
              	;; ==================================================================
              	;; Examines the top of the stack and sets the Z flag if it is non-null
              	;; IN:  -
              	;; OUT: Z flag = set if not null, reset if null
              	;; MOD:
              	;; ==================================================================
06EF:         	CLEAR:
06EF: DD2A190E	    LD      IX, (STACK_POINTER)
              	
06F3: DD7E01  	    LD      A, (IX +1)
06F6: DDB602  	    OR      (IX + 2)
              	
06F9: C9      	    RET
              	    
              	    .include "dictionary/CLEAR-SCREEN.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
06FA:         	CLEAR_SCREEN
              	    .local
06FA: 110707  	    LD      DE, CLEAR_SCREEN_SEQ            ; content
06FD: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
0700: CDEE08  	    CALL    push_string
              	
0703: CD0E07  	    CALL    DOT
              	
0706: C9      	    RET
              	
0707:         	CLEAR_SCREEN_SEQ     DEFL    $
0707: 1B      	    .byte   27
0708: 5B324A  	    .ascii  "[2J"
070B: 1B      	    .byte   27
070C: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
070E:         	DOT
070E: 2A170E  	    LD      HL, (STACK_BASE)
0711: ED5B190E	    LD      DE, (STACK_POINTER)
0715: ED52    	    SBC     HL, DE
0717: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0719: 112107  	    LD      DE, ERROR
071C: 0E09    	    LD      C, $09
071E: C30500  	    JP      $0005
              	
0721: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
0725: 6B206973	
0729: 20656D70	
072D: 74792E5C	
0731: 6E24    	
              	    .endlocal
              	
0733:         	DOT_push_terminator:
              	    .local
0733: 113E07  	    LD      DE, TERMINATOR                  ; content
0736: 010100  	    LD      BC, 0x01                        ; length
0739: CDEE08  	    CALL    push_string
073C: 1801    	    JR      DOT_concatenate
              	
073E: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
073F:         	DOT_concatenate:
073F: CD3B09  	    CALL    stack_concatenate
              	
0742:         	DOT_print:
0742: ED5B190E	    LD      DE, (STACK_POINTER)
0746: 13      	    INC     DE                              ; type byte
0747: 13      	    INC     DE                              ; length word
0748: 13      	    INC     DE
              	
0749: CD2501  	    CALL    bdos_print_string
              	
074C: CD0709  	    CALL    pop_stack
              	
074F: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
              	;; ==========================================================
              	;; Prints the initial greeting
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0750:         	HELP_PROMPT_TEXT
              	    .local
0750: 115A07  	    LD      DE, HELP_PROMPT_NL
0753: 012500  	    LD      BC, HELP_PROMPT_NL_LEN
0756: CDEE08  	    CALL    push_string
              	
0759: C9      	    RET
              	
075A: 54797065	HELP_PROMPT_NL     DEFM    "Type 'help' for A list of commands.", 10, 0
075E: 20276865	
0762: 6C702720	
0766: 666F7220	
