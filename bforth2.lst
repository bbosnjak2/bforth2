              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
0153:         	fill_memory:
0153: 77      	    LD      (HL), A                         ; set the first location
0154: 0B      	    DEC     BC
              	
0155: 54      	    LD      D, H                            ; set the next location as the destination
0156: 5D      	    LD      E, L
0157: 13      	    INC     DE
              	
0158: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
015A: C9      	    RET
              	    
