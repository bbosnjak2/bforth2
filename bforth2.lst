06E5: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
06E8: CD3608  	    CALL    push_string
              	
06EB: CDF606  	    CALL    DOT
              	
06EE: C9      	    RET
              	
