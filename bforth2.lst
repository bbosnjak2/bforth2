              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
079D:         	START:
079D: CD8D07  	    CALL    RESET_STACK
07A0: CDE206  	    CALL    CLEAR_SCREEN
07A3: CD7107  	    CALL    PRINT_GREETING
              	
07A6: C9      	    RET
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
              	;; ==========================================================
