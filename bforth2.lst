              	;; MOD: DE, HL, BC
              	;; ===============================================================
08E4:         	system_fill_memory:
08E4: 77      	    LD      (HL), A                         ; set the first location
08E5: 0B      	    DEC     BC
              	
08E6: 54      	    LD      D, H                            ; set the next location as the destination
08E7: 5D      	    LD      E, L
08E8: 13      	    INC     DE
              	
08E9: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
08EB: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
