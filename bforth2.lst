              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
06F6:         	DOT
06F6: 2AA90D  	    LD      HL, (STACK_BASE)
06F9: ED5BAB0D	    LD      DE, (STACK_POINTER)
06FD: ED52    	    SBC     HL, DE
06FF: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0701: 110907  	    LD      DE, ERROR
0704: 0E09    	    LD      C, $09
0706: C30500  	    JP      $0005
              	
0709: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
070D: 6B206973	
0711: 20656D70	
0715: 74792E5C	
0719: 6E24    	
              	    .endlocal
              	
071B:         	DOT_push_terminator:
              	    .local
071B: 112607  	    LD      DE, TERMINATOR                  ; content
071E: 010100  	    LD      BC, 0x01                        ; length
0721: CD3608  	    CALL    push_string
0724: 1801    	    JR      DOT_concatenate
              	
0726: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
0727:         	DOT_concatenate:
0727: CD8008  	    CALL    stack_concatenate
              	
072A:         	DOT_print:
072A: ED5BAB0D	    LD      DE, (STACK_POINTER)
072E: 13      	    INC     DE                              ; type byte
072F: 13      	    INC     DE                              ; length word
0730: 13      	    INC     DE
              	
0731: CD1501  	    CALL    bdos_print_string
              	
0734: CD4C08  	    CALL    pop_stack
              	
0737: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
