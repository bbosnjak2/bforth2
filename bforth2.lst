              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
07BC:         	print:
07BC: 1A      	    LD      A, (DE)
07BD: B7      	    OR      A
07BE: C8      	    RET     Z                               ; nothing to print
              	
07BF: 3E00    	    LD      A, $00                          ; null terminator
07C1: 62      	    LD      H, D                            ; copy the start address in HL
07C2: 6B      	    LD      L, E
              	
07C3:         	print_find_null_terminator_loop:
07C3: EDA1    	    CPI                                     ; compare (HL) to a null terminator
07C5: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
07C7: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
07C8: 3E24    	    LD      A, '$'
07CA: 77      	    LD      (HL), A
              	
07CB: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
07CC: 0E09    	    LD      C, $09                          ; invoke the CPM print method
07CE: CD0500  	    CALL    $0005
              	
07D1: E1      	    POP     HL                              ; restore HL and put the null terminator back
07D2: 3E00    	    LD      A, $00
07D4: 77      	    LD      (HL), A
              	
07D5: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
07D6:         	print_char:
07D6: 5F      	    LD      E, A
07D7: 0E02    	    LD      C, F_CONSOLE_OUT
07D9: CD0500  	    CALL    BDOS
              	
07DC: C9      	    RET
              	    
              	
              	    .include "system/system-clear-input-buffer.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07DD:         	system_clear_input_buffer
07DD: 21A70D  	    LD      HL, INPUT_BUFFER
07E0: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
07E3: 3E00    	    LD      A, 0x00
              	
07E5: CD1408  	    CALL    system_fill_memory
              	
07E8: C9      	    RET
              	    
              	    .include "system/system-copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07E9:         	system_copy_input_to_current_input:
07E9: 21F80D  	    LD      HL, CURRENT_INPUT
07EC: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07EF: 3E00    	    LD      A, 0x00
07F1: CD1408  	    CALL    system_fill_memory
              	
07F4: DD21480E	    LD      IX, CURRENT_INPUT_LEN
              	
07F8: 21A70D  	    LD      HL, INPUT_BUFFER                ; source
07FB: 11F80D  	    LD      DE, CURRENT_INPUT               ; destination
07FE: ED534A0E	    LD      (CURRENT_INPUT_POS), DE
              	
0802: 3AA60D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
0805: 0600    	    LD      B, 0x00
0807: 4F      	    LD      C, A
0808: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
080B: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
080E: B7      	    OR      A                               ; skip if nothing was input
080F: 2802    	    JR      Z, system_copy_input_to_current_input_done
              	
0811: EDB0    	    LDIR                                    ; copy
              	
0813:         	system_copy_input_to_current_input_done:
0813: C9      	    RET
              	    
              	    .include "system/system-fill-memory.asm"
              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
0814:         	system_fill_memory:
0814: 77      	    LD      (HL), A                         ; set the first location
0815: 0B      	    DEC     BC
              	
0816: 54      	    LD      D, H                            ; set the next location as the destination
0817: 5D      	    LD      E, L
0818: 13      	    INC     DE
              	
0819: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
081B: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;; ==========================================================
081C:         	system_load_input_buffer
081C: CDDD07  	    CALL    system_clear_input_buffer
              	
081F: 11A50D  	    LD      DE, INPUT_BUFFER_SIZE
0822: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0824: 12      	    LD      (DE), A
              	
0825: CD1501  	    CALL    bdos_line_input
              	
              	; echo a LF since BDOS doesn't
0828: 1E0A    	    LD      E, ASCII_LF
082A: CD1B01  	    CALL    bdos_print_char
              	
082D: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
082E:         	push_string:
082E: 2AA30D  	    LD      HL, (STACK_POINTER)
0831: ED42    	    SBC     HL, BC
              	
0833: 2B      	    DEC     HL                              ; 2 bytes for length
0834: 2B      	    DEC     HL
0835: 2B      	    DEC     HL                              ; 1 byte for type
              	
0836: 22A30D  	    LD      (STACK_POINTER), HL
              	
0839: 3601    	    LD      (HL), STACK_STRING_TYPE
083B: 23      	    INC     HL
              	
083C: 71      	    LD      (HL), C
083D: 23      	    INC     HL
083E: 70      	    LD      (HL), B
083F: 23      	    INC     HL
              	
0840: EB      	    EX      DE, HL
0841: EDB0    	    LDIR
              	
