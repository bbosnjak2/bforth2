              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0793:         	RESET_STACK
0793: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
0796: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
0797: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
079A: ED42    	    SBC     HL, BC
              	
079C: 22A10D  	    LD      (STACK_BASE), HL
079F: 22A30D  	    LD      (STACK_POINTER), HL
              	
07A2: C9      	    RET
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
              	;; ==========================================================
              	;; Pushes welcome text onto the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07A3:         	WELCOME_TEXT
              	    .local
07A3: 11AD07  	    LD      DE, TEXT_GREETING_NL
07A6: 011300  	    LD      BC, TEXT_GREETING_NL_LEN
07A9: CD2E08  	    CALL    push_string
              	
07AC: C9      	    RET
              	
07AD: 57656C63	TEXT_GREETING_NL     DEFM    "Welcome to bforth2", 10
07B1: 6F6D6520	
07B5: 746F2062	
07B9: 666F7274	
07BD: 68320A  	
0013:         	TEXT_GREETING_NL_LEN .equ    $ - TEXT_GREETING_NL
              	
              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
07C0:         	print:
07C0: 1A      	    LD      A, (DE)
07C1: B7      	    OR      A
07C2: C8      	    RET     Z                               ; nothing to print
              	
07C3: 3E00    	    LD      A, $00                          ; null terminator
07C5: 62      	    LD      H, D                            ; copy the start address in HL
07C6: 6B      	    LD      L, E
              	
07C7:         	print_find_null_terminator_loop:
07C7: EDA1    	    CPI                                     ; compare (HL) to a null terminator
07C9: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
07CB: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
07CC: 3E24    	    LD      A, '$'
07CE: 77      	    LD      (HL), A
              	
07CF: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
07D0: 0E09    	    LD      C, $09                          ; invoke the CPM print method
07D2: CD0500  	    CALL    $0005
              	
07D5: E1      	    POP     HL                              ; restore HL and put the null terminator back
07D6: 3E00    	    LD      A, $00
07D8: 77      	    LD      (HL), A
              	
07D9: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
07DA:         	print_char:
07DA: 5F      	    LD      E, A
07DB: 0E02    	    LD      C, F_CONSOLE_OUT
07DD: CD0500  	    CALL    BDOS
              	
07E0: C9      	    RET
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07E1:         	clear_input_buffer
07E1: 21A70D  	    LD      HL, INPUT_BUFFER
07E4: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
07E7: 3E00    	    LD      A, 0x00
              	
07E9: CD5301  	    CALL    fill_memory
              	
07EC: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
07ED:         	load_input_buffer
07ED: CDE107  	    CALL    clear_input_buffer
              	
07F0: 11A50D  	    LD      DE, INPUT_BUFFER_SIZE
07F3: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
07F5: 12      	    LD      (DE), A
              	
07F6: 0E0A    	    LD      C, $0A
07F8: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
07FB: 1E0A    	    LD      E, ASCII_LF
07FD: 0E02    	    LD      C, $02
07FF: CD0500  	    CALL    $0005
              	
0802: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0803:         	copy_input_to_current_input:
0803: 21F80D  	    LD      HL, CURRENT_INPUT
0806: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0809: 3E00    	    LD      A, 0x00
080B: CD5301  	    CALL    fill_memory
              	
080E: DD21480E	    LD      IX, CURRENT_INPUT_LEN
              	
0812: 21A70D  	    LD      HL, INPUT_BUFFER                ; source
0815: 11F80D  	    LD      DE, CURRENT_INPUT               ; destination
0818: ED534A0E	    LD      (CURRENT_INPUT_POS), DE
              	
081C: 3AA60D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
081F: 0600    	    LD      B, 0x00
0821: 4F      	    LD      C, A
0822: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
0825: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
0828: B7      	    OR      A                               ; skip if nothing was input
0829: 2802    	    JR      Z, copy_input_to_current_input_done
              	
082B: EDB0    	    LDIR                                    ; copy
              	
082D:         	copy_input_to_current_input_done:
082D: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
082E:         	push_string:
082E: 2AA30D  	    LD      HL, (STACK_POINTER)
0831: ED42    	    SBC     HL, BC
              	
0833: 2B      	    DEC     HL                              ; 2 bytes for length
0834: 2B      	    DEC     HL
0835: 2B      	    DEC     HL                              ; 1 byte for type
              	
0836: 22A30D  	    LD      (STACK_POINTER), HL
              	
0839: 3601    	    LD      (HL), STACK_STRING_TYPE
083B: 23      	    INC     HL
              	
083C: 71      	    LD      (HL), C
083D: 23      	    INC     HL
083E: 70      	    LD      (HL), B
083F: 23      	    INC     HL
              	
0840: EB      	    EX      DE, HL
0841: EDB0    	    LDIR
              	
0843: C9      	    RET
              	    
              	    .include "stack/pop-stack.asm"
              	;; ==========================================================
              	;; Pops the top item from the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0844:         	pop_stack:
0844: 2AA10D  	    LD      HL, (STACK_BASE)
0847: ED5BA30D	    LD      DE, (STACK_POINTER)
084B: ED52    	    SBC     HL, DE
084D: 201A    	    JR      NZ, pop_stack_execute
              	
              	    .local
084F: 115708  	    LD      DE, ERROR
0852: 0E09    	    LD      C, $09
0854: C30500  	    JP      $0005
              	
0857: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
