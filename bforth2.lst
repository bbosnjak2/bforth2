              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
048E:         	skip_whitespace:
048E:         	skip_whitespace_loop:
048E: 7E      	    LD      A, (HL)                         ; A contains the character
048F: B7      	    OR      A                               ; check for null terminator
0490: 2808    	    JR      Z, skip_whitespace_done
              	
0492: CD8301  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0495: 2003    	    JR      NZ, skip_whitespace_done
              	
0497: 23      	    INC     HL
0498: 18F4    	    JR      skip_whitespace_loop
              	
049A:         	skip_whitespace_done:
049A: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a null-terminated string to uppercase in situ.
              	;; IN:  HL - start address
              	;; OUT: HL - original start address
              	;; MOD:
              	;; ===============================================================
049B:         	to_uppercase:
049B: E5      	    PUSH    HL                              ; cache the starting address
              	
049C:         	to_uppercase_loop:
049C: 7E      	    LD      A, (HL)
049D: B7      	    OR      A
049E: 2812    	    JR      Z, to_uppercase_done
              	
04A0:         	to_uppercase_process_character:
04A0: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
04A2: 380B    	    JR      C, to_uppercase_next_character
              	
04A4: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
04A6: 3807    	    JR      C, to_uppercase_next_character
              	
04A8: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
04AA: 3003    	    JR      NC, to_uppercase_next_character
              	
04AC: CBAF    	    RES     5, A                            ; uppercase the character
04AE: 77      	    LD      (HL), A
              	
04AF:         	to_uppercase_next_character:
04AF: 23      	    INC     HL
04B0: 18EA    	    JR      to_uppercase_loop
              	
04B2:         	to_uppercase_done:
04B2: E1      	    POP     HL                              ; restore the starting address
04B3: C9      	    RET
              	    
