              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
07C4:         	print:
07C4: 1A      	    LD      A, (DE)
07C5: B7      	    OR      A
07C6: C8      	    RET     Z                               ; nothing to print
              	
07C7: 3E00    	    LD      A, $00                          ; null terminator
07C9: 62      	    LD      H, D                            ; copy the start address in HL
07CA: 6B      	    LD      L, E
              	
07CB:         	print_find_null_terminator_loop:
07CB: EDA1    	    CPI                                     ; compare (HL) to a null terminator
07CD: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
07CF: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
07D0: 3E24    	    LD      A, '$'
07D2: 77      	    LD      (HL), A
              	
07D3: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
07D4: 0E09    	    LD      C, $09                          ; invoke the CPM print method
07D6: CD0500  	    CALL    $0005
              	
07D9: E1      	    POP     HL                              ; restore HL and put the null terminator back
07DA: 3E00    	    LD      A, $00
07DC: 77      	    LD      (HL), A
              	
07DD: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
07DE:         	print_char:
07DE: 5F      	    LD      E, A
07DF: 0E02    	    LD      C, F_CONSOLE_OUT
07E1: CD0500  	    CALL    BDOS
              	
07E4: C9      	    RET
              	    
              	
              	    .include "system/system-clear-input-buffer.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07E5:         	system_clear_input_buffer
07E5: 21AF0D  	    LD      HL, INPUT_BUFFER
07E8: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
07EB: 3E00    	    LD      A, 0x00
              	
07ED: CD1C08  	    CALL    system_fill_memory
              	
07F0: C9      	    RET
              	    
              	    .include "system/system-copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07F1:         	system_copy_input_to_current_input:
07F1: 21000E  	    LD      HL, CURRENT_INPUT
07F4: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07F7: 3E00    	    LD      A, 0x00
07F9: CD1C08  	    CALL    system_fill_memory
              	
07FC: DD21500E	    LD      IX, CURRENT_INPUT_LEN
              	
0800: 21AF0D  	    LD      HL, INPUT_BUFFER                ; source
0803: 11000E  	    LD      DE, CURRENT_INPUT               ; destination
0806: ED53520E	    LD      (CURRENT_INPUT_POS), DE
              	
080A: 3AAE0D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
080D: 0600    	    LD      B, 0x00
080F: 4F      	    LD      C, A
0810: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
0813: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
0816: B7      	    OR      A                               ; skip if nothing was input
0817: 2802    	    JR      Z, system_copy_input_to_current_input_done
              	
0819: EDB0    	    LDIR                                    ; copy
              	
081B:         	system_copy_input_to_current_input_done:
081B: C9      	    RET
              	    
              	    .include "system/system-fill-memory.asm"
              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
081C:         	system_fill_memory:
081C: 77      	    LD      (HL), A                         ; set the first location
081D: 0B      	    DEC     BC
              	
081E: 54      	    LD      D, H                            ; set the next location as the destination
081F: 5D      	    LD      E, L
0820: 13      	    INC     DE
              	
0821: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
0823: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;; ==========================================================
0824:         	system_load_input_buffer
0824: CDE507  	    CALL    system_clear_input_buffer
              	
0827: 11AD0D  	    LD      DE, INPUT_BUFFER_SIZE
082A: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
082C: 12      	    LD      (DE), A
              	
082D: CD0901  	    CALL    bdos_line_input
              	
              	; echo a LF since BDOS doesn't
0830: 1E0A    	    LD      E, ASCII_LF
0832: CD0F01  	    CALL    bdos_print_char
              	
0835: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
0836:         	push_string:
0836: 2AAB0D  	    LD      HL, (STACK_POINTER)
0839: ED42    	    SBC     HL, BC
              	
