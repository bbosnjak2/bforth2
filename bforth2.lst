              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
04A1:         	skip_whitespace:
04A1:         	skip_whitespace_loop:
04A1: 7E      	    LD      A, (HL)                         ; A contains the character
04A2: B7      	    OR      A                               ; check for null terminator
04A3: 2808    	    JR      Z, skip_whitespace_done
              	
04A5: CD9601  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
04A8: 2003    	    JR      NZ, skip_whitespace_done
              	
04AA: 23      	    INC     HL
04AB: 18F4    	    JR      skip_whitespace_loop
              	
04AD:         	skip_whitespace_done:
04AD: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a null-terminated string to uppercase in situ.
              	;; IN:  HL - start address
              	;; OUT: HL - original start address
              	;; MOD:
              	;; ===============================================================
04AE:         	to_uppercase:
04AE: E5      	    PUSH    HL                              ; cache the starting address
              	
04AF:         	to_uppercase_loop:
04AF: 7E      	    LD      A, (HL)
04B0: B7      	    OR      A
04B1: 2812    	    JR      Z, to_uppercase_done
              	
04B3:         	to_uppercase_process_character:
04B3: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
04B5: 380B    	    JR      C, to_uppercase_next_character
              	
04B7: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
04B9: 3807    	    JR      C, to_uppercase_next_character
              	
04BB: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
04BD: 3003    	    JR      NC, to_uppercase_next_character
              	
04BF: CBAF    	    RES     5, A                            ; uppercase the character
04C1: 77      	    LD      (HL), A
              	
04C2:         	to_uppercase_next_character:
04C2: 23      	    INC     HL
04C3: 18EA    	    JR      to_uppercase_loop
              	
04C5:         	to_uppercase_done:
04C5: E1      	    POP     HL                              ; restore the starting address
04C6: C9      	    RET
              	    
