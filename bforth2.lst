09D5: 118A01  	    LD      DE, NOT_IMPLEMENTED_NL
09D8: C35007  	    JP      print
              	
09DB: CD4309  	    CALL    parse_token
              	
09DE: 78      	    LD      A, B                            ; check if a word was specified
09DF: B7      	    OR      A
09E0: 283D    	    JR      Z, add_command_syntax_error
              	
09E2: 2A3D0E  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
09E5: 7E      	    LD      A, (HL)
09E6: B7      	    OR      A
09E7: 2036    	    JR      NZ, add_command_syntax_error
              	
09E9:         	add_command_write_word_text:
09E9: DD2A1F0F	    LD      IX, (WORD_LIST_NEXT)
              	
09ED: 78      	    LD      A, B                            ; write the number of characters (excludes the null terminator)
09EE: DD7700  	    LD      (IX + 0), A
              	
09F1: 2A1D0F  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
09F4: DD7501  	    LD      (IX + 1), HL
09F7: DD7402  	
              	
09FA: C5      	    PUSH    BC                              ; save the number of characters value that's in B
              	
09FB: 2A1F0F  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
09FE: 110500  	    LD      DE, 5                           ; offset HL to the location to write the word itself
0A01: 19      	    ADD     HL, DE
              	
0A02: DD7503  	    LD      (IX + 3), HL                    ; update the header with the location where the text will be copied to
0A05: DD7404  	
              	
0A08: EB      	    EX      DE, HL                          ; update DE to be the destination pointed to by HL
0A09: 21400E  	    LD      HL, CURRENT_TOKEN               ; HL is the source
              	
0A0C: 48      	    LD      C, B
0A0D: 0600    	    LD      B, 0x00
0A0F: 03      	    INC     BC                              ; copy the null terminated, too
              	
0A10: EDB0    	    LDIR                                    ; write the word, DE will be the new WORD_LIST_NEXT value
              	
0A12: C1      	    POP     BC                              ; restore the number of characters value in B
              	
