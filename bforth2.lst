              	;; MOD: A, DE
              	;; ==========================================================
097D:         	system_load_input_buffer
097D: CD3E09  	    CALL    system_clear_input_buffer
              	
0980: 112F0E  	    LD      DE, INPUT_BUFFER_SIZE
0983: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0985: 12      	    LD      (DE), A
              	
0986: CD2401  	    CALL    bdos_line_input
              	
              	; echo a LF since BDOS doesn't
0989: 1E0A    	    LD      E, ASCII_LF
098B: CD2A01  	    CALL    bdos_print_char
              	
098E: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
098F:         	push_string:
098F: 2A2D0E  	    LD      HL, (STACK_POINTER)
0992: ED42    	    SBC     HL, BC
              	
0994: 2B      	    DEC     HL                              ; 2 bytes for length
0995: 2B      	    DEC     HL
0996: 2B      	    DEC     HL                              ; 1 byte for type
              	
0997: 222D0E  	    LD      (STACK_POINTER), HL
              	
099A: 3601    	    LD      (HL), STACK_STRING_TYPE
099C: 23      	    INC     HL
              	
099D: 71      	    LD      (HL), C
099E: 23      	    INC     HL
099F: 70      	    LD      (HL), B
09A0: 23      	    INC     HL
              	
09A1: 78      	    LD      A, B
09A2: B1      	    OR      C
09A3: C8      	    RET     Z                               ; zero-length string
              	
09A4: EB      	    EX      DE, HL
09A5: EDB0    	    LDIR
              	
09A7: C9      	    RET
              	    
              	    .include "stack/pop-stack.asm"
              	;; ==========================================================
              	;; Pops the top item from the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
09A8:         	pop_stack:
09A8: 2A2B0E  	    LD      HL, (STACK_BASE)
09AB: ED5B2D0E	    LD      DE, (STACK_POINTER)
09AF: ED52    	    SBC     HL, DE
09B1: 201A    	    JR      NZ, pop_stack_execute
              	
              	    .local
09B3: 11BB09  	    LD      DE, ERROR
09B6: 0E09    	    LD      C, $09
09B8: C30500  	    JP      $0005
              	
09BB: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
09BF: 6B206973	
09C3: 20656D70	
09C7: 74792E5C	
09CB: 6E24    	
              	    .endlocal
              	
09CD:         	pop_stack_execute:
09CD: 2A2D0E  	    LD      HL, (STACK_POINTER)
09D0: 23      	    INC     HL                              ; skip the type
              	
09D1: 4E23462B	    LD      BC, (HL)                        ; load the string length
09D5: 23      	    INC     HL
09D6: 23      	    INC     HL
              	
09D7: 09      	    ADD     HL, BC                          ; calculate location after the string
              	
09D8: 222D0E  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
09DB: C9      	    RET
              	    
              	    .include "stack/pop-string.asm"
              	;; ==========================================================
              	;; Pops the top string from the stack.  Caller is responsible
              	;; for checking if the stack has a (string) value
              	;; IN:
              	;; OUT: BC - length
              	;;      HL - text
              	;; MOD:
              	;; ==========================================================
09DC:         	pop_string:
09DC: 2A2D0E  	    LD      HL, (STACK_POINTER)
09DF: 23      	    INC     HL                              ; skip the type
              	
09E0: 4E23462B	    LD      BC, (HL)                        ; load the string length
09E4: 23      	    INC     HL
09E5: 23      	    INC     HL                              ; string address
              	
09E6: E5      	    PUSH    HL                              ; store the address
              	
09E7: 09      	    ADD     HL, BC                          ; calculate location after the string
09E8: 222D0E  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
09EB: E1      	    POP     HL                              ; restore the string address
              	
09EC: C9      	    RET
              	    
              	    .include "stack/stack-concatenate.asm"
              	;; ===============================================================
              	;; Concatenates the two strings on the stack, replacing them with
              	;; the concatenation
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ===============================================================
09ED:         	stack_concatenate:
09ED: 2A2B0E  	    LD      HL, (STACK_BASE)
09F0: ED5B2D0E	    LD      DE, (STACK_POINTER)
09F4: ED52    	    SBC     HL, DE
09F6: 201A    	    JR      NZ, stack_concatenate_execute
              	
              	    .local
09F8: 11000A  	    LD      DE, ERROR
09FB: 0E09    	    LD      C, $09
09FD: C30500  	    JP      $0005
              	
0A00: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
0A04: 6B206973	
0A08: 20656D70	
0A0C: 74792E5C	
0A10: 6E24    	
              	    .endlocal
              	
0A12:         	stack_concatenate_execute:
0A12: DD2A2D0E	    LD      IX, (STACK_POINTER)             ; second string
              	
0A16: 2A2D0E  	    LD      HL, (STACK_POINTER)
0A19: DD4E01  	    LD      BC, (IX + 1)                    ; string length
0A1C: DD4602  	
0A1F: 09      	    ADD     HL, BC
              	
0A20: 010300  	    LD      BC, 0x0003                      ; header length
0A23: 09      	    ADD     HL, BC
              	
0A24: E5      	    PUSH    HL
0A25: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
0A27: ED5B2D0E	    LD      DE, (STACK_POINTER)
0A2B: 1B      	    DEC     DE
              	
              	; copy the second word
0A2C: DD4E01  	    LD      BC, (IX + 1)                    ; count
0A2F: DD4602  	
0A32: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
0A34: E1      	    POP     HL
0A35: 09      	    ADD     HL, BC
0A36: 23      	    INC     HL
0A37: 23      	    INC     HL
              	
0A38: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
0A3A: FD4E01  	    LD      BC, (IY + 1)                    ; count
0A3D: FD4602  	
0A40: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
0A42: E1      	    POP     HL
0A43: 09      	    ADD     HL, BC
0A44: 23      	    INC     HL
0A45: 23      	    INC     HL
              	
0A46: EDB8    	    LDDR                                    ; copy second word down
              	
0A48: 13      	    INC     DE                              ; point to the start of the new string
              	
0A49: DD6E01  	    LD      HL, (IX + 1)
0A4C: DD6602  	
0A4F: FD4E01  	    LD      BC, (IY + 1)
0A52: FD4602  	
0A55: 09      	    ADD     HL, BC
0A56: 444D    	    LD      BC, HL                          ; combined length
              	
0A58: D9      	    EXX
0A59: CDA809  	    CALL    pop_stack
0A5C: CDA809  	    CALL    pop_stack
0A5F: D9      	    EXX
              	
0A60: CD8F09  	    CALL    push_string
              	
0A63: C9      	    RET
              	    
              	
