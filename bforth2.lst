0903: 2B      	    DEC     HL                              ; 2 bytes for length
0904: 2B      	    DEC     HL
0905: 2B      	    DEC     HL                              ; 1 byte for type
              	
0906: 22290E  	    LD      (STACK_POINTER), HL
              	
0909: 3601    	    LD      (HL), STACK_STRING_TYPE
090B: 23      	    INC     HL
              	
090C: 71      	    LD      (HL), C
090D: 23      	    INC     HL
090E: 70      	    LD      (HL), B
090F: 23      	    INC     HL
              	
0910: 78      	    LD      A, B
0911: B1      	    OR      C
0912: C8      	    RET     Z                               ; zero-length string
              	
0913: EB      	    EX      DE, HL
0914: EDB0    	    LDIR
              	
0916: C9      	    RET
              	    
