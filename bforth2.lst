08B3: 010300  	    LD      BC, 0x0003                      ; header length
08B6: 09      	    ADD     HL, BC
              	
08B7: E5      	    PUSH    HL
08B8: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
