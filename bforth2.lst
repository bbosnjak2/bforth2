              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
015B:         	is_whitespace:
015B: FE20    	    CP      A, ASCII_SPACE
015D: C8      	    RET     Z
              	
015E: FE09    	    CP      A, ASCII_TAB
0160: C8      	    RET     Z
              	
0161: FE0D    	    CP      A, ASCII_CR
0163: C8      	    RET     Z
              	
0164: FE0A    	    CP      A, ASCII_LF
0166: C8      	    RET     Z
              	
0167: FE0C    	    CP      A, ASCII_FF
0169: C8      	    RET     Z
              	
016A: FE0B    	    CP      A, ASCII_VT
016C: C8      	    RET     Z
              	
016D: C9      	    RET
              	    
