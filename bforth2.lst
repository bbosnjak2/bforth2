              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
08E2:         	process_current_input:
08E2: CD4309  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
08E5: 21400E  	    LD      HL, CURRENT_TOKEN
08E8: 3A3F0E  	    LD      A, (CURRENT_TOKEN_LEN)
08EB: B7      	    OR      A
08EC: 2817    	    JR      Z, process_current_input_done
              	
08EE: 47      	    LD      B, A
08EF: CDBD04  	    CALL    to_uppercase
              	
08F2: CD0609  	    CALL    find_command_method_address
              	
08F5: 280D    	    JR      Z, process_current_input_command_recognized
              	
08F7:         	process_current_input_command_not_recognized:
08F7: 11400E  	    LD      DE, CURRENT_TOKEN
08FA: CD5007  	    CALL    print
08FD: 117101  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
0900: CD5007  	    CALL    print
0903: C9      	    RET
              	
0904:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
0904: E9      	    JP      HL
              	
0905:         	process_current_input_done:
0905: C9      	    RET
              	
              	    .include "find-command-method-address.asm"
              	;; ==================================================================
              	;; Finds the command in CURRENT_COMMAND in the command list.
              	;; IN:  -
