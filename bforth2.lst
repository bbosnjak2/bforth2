              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
091D:         	print:
091D: 1A      	    LD      A, (DE)
091E: B7      	    OR      A
091F: C8      	    RET     Z                               ; nothing to print
              	
0920: 3E00    	    LD      A, $00                          ; null terminator
0922: 62      	    LD      H, D                            ; copy the start address in HL
0923: 6B      	    LD      L, E
              	
0924:         	print_find_null_terminator_loop:
0924: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0926: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0928: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0929: 3E24    	    LD      A, '$'
092B: 77      	    LD      (HL), A
              	
092C: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
092D: 0E09    	    LD      C, $09                          ; invoke the CPM print method
092F: CD0500  	    CALL    $0005
              	
0932: E1      	    POP     HL                              ; restore HL and put the null terminator back
0933: 3E00    	    LD      A, $00
0935: 77      	    LD      (HL), A
              	
0936: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
