              	    .endlocal
              	    
              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07CA:         	RESET_STACK
07CA: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
07CD: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
07CE: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
07D1: ED42    	    SBC     HL, BC
              	
07D3: 222B0E  	    LD      (STACK_BASE), HL
07D6: 222D0E  	    LD      (STACK_POINTER), HL
              	
07D9: C9      	    RET
              	    
              	    .include "dictionary/SEARCH.asm"
              	;; ==================================================================
              	;; Searches for the command identified by the token on the stack.
              	;; If found, the token is popped and the command address pushed to the
              	;; CPU stack and Z is true.  If not found, the token is untouched and
              	;; NZ is true.
              	;;
              	;; IN:  -
              	;; OUT: -
              	;; MOD:
              	;; ==========================================================
07DA:         	SEARCH:
07DA: DD219404	    LD      IX, COMMAND_LIST
07DE: FD2A2D0E	    LD      IY, (STACK_POINTER)
07E2: FD4E01  	    LD      BC, (IY + 1)
07E5: FD4602  	
              	
07E8:         	SEARCH_check_command:
07E8: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
07EB: B7      	    OR      A                               ; if 0, then end of list reached
07EC: 283B    	    JR      Z, SEARCH_not_found
              	
07EE: B9      	    CP      C                               ; if the length differs, move to the next command
07EF: 2016    	    JR      NZ, SEARCH_next_command
              	
07F1:         	SEARCH_compare:
07F1: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
07F4: DD6604  	
07F7: FD4E01  	    LD      BC, (IY + 1)                    ; number of characters
07FA: FD4602  	
              	
07FD: FDE5    	    PUSH    IY
07FF: D1      	    POP     DE
0800: 13      	    INC     DE                              ; stack entry type
0801: 13      	    INC     DE                              ; stack entry length
0802: 13      	    INC     DE                              ; result is the address of the token text on the stack
              	
0803:         	SEARCH_compare_loop:
0803: 1A      	    LD      A, (DE)
0804: BE      	    CP      (HL)
0805: 280B    	    JR      Z, SEARCH_compare_next_character
              	
0807:         	SEARCH_next_command:
0807: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
080A: DD6601  	
080D: E5      	    PUSH    HL
080E: DDE1    	    POP     IX
0810: 18D6    	    JR      SEARCH_check_command
              	
0812:         	SEARCH_compare_next_character:
0812: 23      	    INC     HL
0813: 13      	    INC     DE
0814: 0B      	    DEC     BC                              ; move to next character
              	
0815: 78      	    LD      A, B
0816: B1      	    OR      C
0817: 20EA    	    JR      NZ, SEARCH_compare_loop
              	
0819:         	SEARCH_found:                               ; all characters have matched
0819: CDA809  	    CALL    pop_stack                       ; consume the token
              	
081C: DD6E0B  	    LD      HL, (IX + COMMAND_METHOD_ADDRESS) ; put the command address on the stack
081F: DD660C  	
              	
0822: D1      	    POP     DE                              ; get the return address
0823: E5      	    PUSH    HL                              ; push the command address
0824: D5      	    PUSH    DE                              ; push the return address back
              	
0825: 3E00    	    LD      A, $00
0827: B7      	    OR      A                               ; clears the Z flag (means found)
              	
0828: C9      	    RET
              	
0829:         	SEARCH_not_found:
0829: 3E01    	    LD      A, $01
082B: B7      	    OR      A                               ; sets the Z flag
              	
082C: C9      	    RET
              	    
              	    .include "dictionary/STACK-EMPTY.asm"
              	;; ==========================================================
              	;; Checks if the stack is empty, printing an error message if
              	;; so and sets the Z flag.  Otherwise clears the Z flag.
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
082D:         	STACK_EMPTY:
              	    .local
082D: 2A2D0E  	    LD      HL, (STACK_POINTER)
0830: ED5B2B0E	    LD      DE, (STACK_BASE)
              	
0834: 37      	    SCF
0835: 3F      	    CCF
0836: ED52    	    SBC     HL, DE
              	
0838: 7C      	    LD      A, H
0839: B5      	    OR      L
              	
083A: C0      	    RET     NZ
              	
083B: 114908  	    LD      DE, ERROR
083E: 010D00  	    LD      BC, ERROR_LEN
0841: CD8F09  	    CALL    push_string
              	
0844: CD1507  	    CALL    DOT
              	
0847: AF      	    XOR     A                               ; set the Z flag
              	
0848: C9      	    RET
              	
