08D0: FD4602  	
08D3: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
08D5: E1      	    POP     HL
08D6: 09      	    ADD     HL, BC
08D7: 23      	    INC     HL
08D8: 23      	    INC     HL
              	
08D9: EDB8    	    LDDR                                    ; copy second word down
              	
08DB: 13      	    INC     DE                              ; point to the start of the new string
              	
