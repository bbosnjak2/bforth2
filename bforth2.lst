0878: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
0879: 7E      	    LD      A, (HL)                         ; load the next character
087A: CD9901  	    CALL    is_whitespace
087D: 20EF    	    JR      NZ, parse_token_copy_token_loop
              	
087F:         	parse_token_end_of_input:
