098B: FD4602  	
098E: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
0990: E1      	    POP     HL
0991: 09      	    ADD     HL, BC
0992: 23      	    INC     HL
0993: 23      	    INC     HL
              	
0994: EDB8    	    LDDR                                    ; copy second word down
              	
0996: 13      	    INC     DE                              ; point to the start of the new string
              	
0997: DD6E01  	    LD      HL, (IX + 1)
099A: DD6602  	
099D: FD4E01  	    LD      BC, (IY + 1)
09A0: FD4602  	
