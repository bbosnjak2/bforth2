0785: CDB908  	    CALL    system_copy_input_to_current_input
              	
0788: C9      	    RET
              	    
              	    .include "dictionary/OK.asm"
              	;; ==========================================================
              	;; Outputs the OK response
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
0789:         	OK
              	    .local
0789: 119607  	    LD      DE, OK_PROMPT                   ; content
078C: 010300  	    LD      BC, OK_PROMPT_LEN               ; length
078F: CDFE08  	    CALL    push_string
              	
0792: CD0E07  	    CALL    DOT
              	
0795: C9      	    RET
              	
