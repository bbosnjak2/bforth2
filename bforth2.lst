0A16: 221D0F  	    LD      (WORD_LIST_HEAD), HL
0A19: ED531F0F	    LD      (WORD_LIST_NEXT), DE            ; the next location is now where DE ended up
              	
0A1D: 1807    	    JR      add_command_done
              	
