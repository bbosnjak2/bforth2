              	    .include "output/clear-screen.cpm.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
072D:         	clear_screen
072D: 113607  	    LD      DE, CLEAR_SCREEN_SEQ
0730: 0E09    	    LD      C, $09
0732: CD0500  	    CALL    $0005
              	
0735: C9      	    RET
              	
0736:         	CLEAR_SCREEN_SEQ    DEFL    $
0736: 1B      	    .byte   27
0737: 5B324A  	    .ascii  "[2J"
073A: 1B      	    .byte   27
073B: 5B48    	    .ascii  "[H"
073D: 24      	    .ascii  "$"
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
073E:         	print:
073E: 1A      	    LD      A, (DE)
073F: B7      	    OR      A
0740: C8      	    RET     Z                               ; nothing to print
              	
0741: 3E00    	    LD      A, $00                          ; null terminator
0743: 62      	    LD      H, D                            ; copy the start address in HL
0744: 6B      	    LD      L, E
              	
0745:         	print_find_null_terminator_loop:
0745: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0747: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0749: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
074A: 3E24    	    LD      A, '$'
074C: 77      	    LD      (HL), A
              	
074D: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
074E: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0750: CD0500  	    CALL    $0005
              	
0753: E1      	    POP     HL                              ; restore HL and put the null terminator back
0754: 3E00    	    LD      A, $00
0756: 77      	    LD      (HL), A
              	
0757: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0758:         	print_char:
0758: 5F      	    LD      E, A
0759: 0E02    	    LD      C, F_CONSOLE_OUT
075B: CD0500  	    CALL    BDOS
              	
075E: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE
              	;; ==========================================================
075F:         	prompt
075F: 115B01  	    LD      DE, INPUT_PROMPT_SP
0762: CD3E07  	    CALL    print
              	
0765: C9      	    RET
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0766:         	clear_input_buffer
0766: 21670C  	    LD      HL, INPUT_BUFFER
0769: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
076C: 3E00    	    LD      A, 0x00
              	
076E: CD8E01  	    CALL    fill_memory
              	
0771: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
0772:         	load_input_buffer
0772: CD6607  	    CALL    clear_input_buffer
              	
0775: 11650C  	    LD      DE, INPUT_BUFFER_SIZE
0778: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
077A: 12      	    LD      (DE), A
              	
077B: 0E0A    	    LD      C, $0A
077D: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
0780: 1E0A    	    LD      E, ASCII_LF
0782: 0E02    	    LD      C, $02
0784: CD0500  	    CALL    $0005
              	
0787: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0788:         	copy_input_to_current_input:
0788: 21B80C  	    LD      HL, CURRENT_INPUT
078B: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
078E: 3E00    	    LD      A, 0x00
0790: CD8E01  	    CALL    fill_memory
              	
0793: DD21080D	    LD      IX, CURRENT_INPUT_LEN
              	
0797: 21670C  	    LD      HL, INPUT_BUFFER                ; source
079A: 11B80C  	    LD      DE, CURRENT_INPUT               ; destination
079D: ED530A0D	    LD      (CURRENT_INPUT_POS), DE
              	
07A1: 3A660C  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
07A4: 0600    	    LD      B, 0x00
07A6: 4F      	    LD      C, A
07A7: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
07AA: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
07AD: B7      	    OR      A                               ; skip if nothing was input
07AE: 2802    	    JR      Z, copy_input_to_current_input_done
              	
07B0: EDB0    	    LDIR                                    ; copy
              	
07B2:         	copy_input_to_current_input_done:
07B2: C9      	    RET
              	    
              	
              	    .include "command-processor/process-current-input.asm"
              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
07B3:         	process_current_input:
07B3: CD1408  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
07B6: 210D0D  	    LD      HL, CURRENT_TOKEN
07B9: 3A0C0D  	    LD      A, (CURRENT_TOKEN_LEN)
07BC: B7      	    OR      A
07BD: 2817    	    JR      Z, process_current_input_done
              	
07BF: 47      	    LD      B, A
07C0: CDAE04  	    CALL    to_uppercase
              	
07C3: CDD707  	    CALL    find_command_method_address
              	
07C6: 280D    	    JR      Z, process_current_input_command_recognized
              	
07C8:         	process_current_input_command_not_recognized:
07C8: 110D0D  	    LD      DE, CURRENT_TOKEN
07CB: CD3E07  	    CALL    print
07CE: 116201  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
07D1: CD3E07  	    CALL    print
07D4: C9      	    RET
              	
07D5:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
07D5: E9      	    JP      HL
              	
07D6:         	process_current_input_done:
07D6: C9      	    RET
              	
              	    .include "find-command-method-address.asm"
              	;; ==================================================================
              	;; Finds the command in CURRENT_COMMAND in the command list.
              	;; IN:  -
              	;; OUT: HL = address of command method
              	;;      Z = set if command found (NZ if not found)
              	;; MOD: A, B, C, HL, DE, IX
              	;; ==========================================================
07D7:         	find_command_method_address:
07D7: DD21CB04	    LD      IX, COMMAND_LIST
07DB: 3A0C0D  	    LD      A, (CURRENT_TOKEN_LEN)
07DE: 47      	    LD      B, A
              	
07DF:         	find_command_method_address_check_command:
07DF: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
07E2: B7      	    OR      A                               ; if 0, then end of list reached
07E3: 282B    	    JR      Z, find_command_method_address_not_found
              	
07E5: B8      	    CP      B                               ; if the length differs, move to the next command
07E6: 200E    	    JR      NZ, find_command_method_address_next_command
              	
07E8:         	find_command_method_address_compare:
07E8: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
07EB: DD6604  	
07EE: 110D0D  	    LD      DE, CURRENT_TOKEN
07F1: 48      	    LD      C, B                            ; number of characters
              	
07F2:         	find_command_method_address_compare_loop:
07F2: 1A      	    LD      A, (DE)
07F3: BE      	    CP      (HL)
07F4: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
07F6:         	find_command_method_address_next_command:
07F6: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
07F9: DD6601  	
07FC: E5      	    PUSH    HL
07FD: DDE1    	    POP     IX
07FF: 18DE    	    JR      find_command_method_address_check_command
              	
0801:         	find_command_method_address_compare_next_character:
0801: 23      	    INC     HL
0802: 13      	    INC     DE
0803: 0D      	    DEC     C                               ; move to next character
0804: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
0806:         	find_command_method_address_found:          ; all characters have matched
0806: DD6E09  	    LD      HL, (IX + COMMAND_METHOD_ADDRESS)
0809: DD660A  	
080C: 3E00    	    LD      A, $00
080E: B7      	    OR      A                               ; clears the Z flag
080F: C9      	    RET
              	
0810:         	find_command_method_address_not_found:
0810: 3E01    	    LD      A, $01
0812: B7      	    OR      A                               ; sets the Z flag
              	
0813: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
0814:         	parse_token:
0814: DD21080D	    LD      IX, CURRENT_INPUT_LEN
0818: FD210C0D	    LD      IY, CURRENT_TOKEN_LEN
              	
081C: 210D0D  	    LD      HL, CURRENT_TOKEN
081F: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0822: 3E00    	    LD      A, 0x00
0824: FD360000	    LD      (IY), 0x00
0828: CD8E01  	    CALL    fill_memory
              	
082B: 2A0A0D  	    LD      HL, (CURRENT_INPUT_POS)
082E: 110D0D  	    LD      DE, CURRENT_TOKEN
              	
0831:         	parse_token_skip_whitespace:
0831: DD7E01  	    LD      A, (IX + 1)                     ; CURRENT_INPUT_REMAINING_LEN
0834: B7      	    OR      A
0835: 281D    	    JR      Z, parse_token_end_of_input
              	
0837: 7E      	    LD      A, (HL)
              	
0838: CD9601  	    CALL    is_whitespace
083B: 2006    	    JR      NZ, parse_token_copy_token_loop
              	
083D: 23      	    INC     HL
083E: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
0841: 18EE    	    JR      parse_token_skip_whitespace
              	
0843:         	parse_token_copy_token_loop:
0843: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
0844: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0847: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0848: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
084B: 2807    	    JR      Z, parse_token_end_of_token
              	
084D: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
084E: 7E      	    LD      A, (HL)                         ; load the next character
084F: CD9601  	    CALL    is_whitespace
