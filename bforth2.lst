0966: 7E      	    LD      A, (HL)
              	
0967: CDA501  	    CALL    is_whitespace
096A: 2006    	    JR      NZ, parse_token_copy_token_loop
              	
096C: 23      	    INC     HL
096D: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
0970: 18EE    	    JR      parse_token_skip_whitespace
              	
0972:         	parse_token_copy_token_loop:
0972: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
0973: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0976: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0977: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
097A: 2807    	    JR      Z, parse_token_end_of_token
              	
097C: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
097D: 7E      	    LD      A, (HL)                         ; load the next character
097E: CDA501  	    CALL    is_whitespace
0981: 20EF    	    JR      NZ, parse_token_copy_token_loop
              	
0983:         	parse_token_end_of_input:
