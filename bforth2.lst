0A6B: B7      	    OR      A                               ; if 0, then end of list reached
0A6C: 2845    	    JR      Z, help_command_done
              	
0A6E: DD5E05  	    LD      DE, (IX + COMMAND_SYNTAX)
0A71: DD5606  	
0A74: DD4E02  	    LD      C, (IX + COMMAND_KEYWORD_LEN)
0A77: 0600    	    LD      B, 0x00
0A79: CD8F09  	    CALL    push_string
              	
