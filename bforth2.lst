              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
078F:         	RESET_STACK
078F: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
0792: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
0793: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
0796: ED42    	    SBC     HL, BC
              	
0798: 22A10D  	    LD      (STACK_BASE), HL
079B: 22A30D  	    LD      (STACK_POINTER), HL
              	
079E: C9      	    RET
              	    
