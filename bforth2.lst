              	;; ==================================================================
              	;; Examines the top of the stack and sets the Z flag if it is non-null
              	;; IN:  -
              	;; OUT: Z flag = set if not null, reset if null
              	;; MOD:
              	;; ==================================================================
06F6:         	CLEAR:
06F6: DD2A380E	    LD      IX, (STACK_POINTER)
              	
06FA: DD7E01  	    LD      A, (IX +1)
06FD: DDB602  	    OR      (IX + 2)
              	
0700: C9      	    RET
              	    
              	    .include "dictionary/CLEAR-SCREEN.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0701:         	CLEAR_SCREEN
              	    .local
0701: 110E07  	    LD      DE, CLEAR_SCREEN_SEQ            ; content
0704: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
0707: CD6609  	    CALL    push_string
              	
070A: CD1507  	    CALL    DOT
              	
070D: C9      	    RET
              	
070E:         	CLEAR_SCREEN_SEQ     DEFL    $
070E: 1B      	    .byte   27
070F: 5B324A  	    .ascii  "[2J"
0712: 1B      	    .byte   27
0713: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0715:         	DOT
0715: 2A360E  	    LD      HL, (STACK_BASE)
0718: ED5B380E	    LD      DE, (STACK_POINTER)
071C: ED52    	    SBC     HL, DE
071E: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0720: 112807  	    LD      DE, ERROR
0723: 0E09    	    LD      C, $09
0725: C30500  	    JP      $0005
              	
0728: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
072C: 6B206973	
0730: 20656D70	
0734: 74792E5C	
0738: 6E24    	
              	    .endlocal
              	
073A:         	DOT_push_terminator:
              	    .local
073A: 114507  	    LD      DE, TERMINATOR                  ; content
073D: 010100  	    LD      BC, 0x01                        ; length
0740: CD6609  	    CALL    push_string
0743: 1801    	    JR      DOT_concatenate
              	
0745: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
0746:         	DOT_concatenate:
0746: CDB309  	    CALL    stack_concatenate
              	
0749:         	DOT_print:
0749: ED5B380E	    LD      DE, (STACK_POINTER)
074D: 13      	    INC     DE                              ; type byte
074E: 13      	    INC     DE                              ; length word
074F: 13      	    INC     DE
              	
0750: CD3001  	    CALL    bdos_print_string
              	
0753: CD7F09  	    CALL    pop_stack
              	
0756: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
              	;; ==========================================================
