              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
0462:         	skip_whitespace:
0462:         	skip_whitespace_loop:
0462: 7E      	    LD      A, (HL)                         ; A contains the character
0463: B7      	    OR      A                               ; check for null terminator
0464: 2808    	    JR      Z, skip_whitespace_done
              	
0466: CD5701  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0469: 2003    	    JR      NZ, skip_whitespace_done
              	
046B: 23      	    INC     HL
046C: 18F4    	    JR      skip_whitespace_loop
              	
046E:         	skip_whitespace_done:
046E: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
046F:         	to_uppercase:
046F: E5      	    PUSH    HL                              ; cache the starting address
0470: C5      	    PUSH    BC                              ; cache the length
              	
0471:         	to_uppercase_loop:
0471: 78      	    LD      A, B
0472: B7      	    OR      A
0473: 2814    	    JR      Z, to_uppercase_done
              	
0475: 7E      	    LD      A, (HL)
              	
0476:         	to_uppercase_process_character:
0476: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
0478: 380B    	    JR      C, to_uppercase_next_character
              	
047A: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
047C: 3807    	    JR      C, to_uppercase_next_character
              	
047E: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
0480: 3003    	    JR      NC, to_uppercase_next_character
              	
0482: CBAF    	    RES     5, A                            ; uppercase the character
0484: 77      	    LD      (HL), A
              	
0485:         	to_uppercase_next_character:
0485: 23      	    INC     HL
0486: 05      	    DEC     B
0487: 18E8    	    JR      to_uppercase_loop
              	
0489:         	to_uppercase_done:
0489: C1      	    POP     BC                              ; restore the length
048A: E1      	    POP     HL                              ; restore the starting address
              	
048B: C9      	    RET
              	    
