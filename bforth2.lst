              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
0966:         	push_string:
0966: 2A380E  	    LD      HL, (STACK_POINTER)
0969: ED42    	    SBC     HL, BC
              	
096B: 2B      	    DEC     HL                              ; 2 bytes for length
096C: 2B      	    DEC     HL
096D: 2B      	    DEC     HL                              ; 1 byte for type
              	
096E: 22380E  	    LD      (STACK_POINTER), HL
              	
0971: 3601    	    LD      (HL), STACK_STRING_TYPE
0973: 23      	    INC     HL
              	
0974: 71      	    LD      (HL), C
0975: 23      	    INC     HL
0976: 70      	    LD      (HL), B
0977: 23      	    INC     HL
              	
0978: 78      	    LD      A, B
0979: B1      	    OR      C
097A: C8      	    RET     Z                               ; zero-length string
              	
097B: EB      	    EX      DE, HL
097C: EDB0    	    LDIR
              	
097E: C9      	    RET
              	    
              	    .include "stack/pop-stack.asm"
              	;; ==========================================================
              	;; Pops the top item from the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
097F:         	pop_stack:
097F: 2A360E  	    LD      HL, (STACK_BASE)
0982: ED5B380E	    LD      DE, (STACK_POINTER)
0986: ED52    	    SBC     HL, DE
0988: 201A    	    JR      NZ, pop_stack_execute
              	
              	    .local
098A: 119209  	    LD      DE, ERROR
098D: 0E09    	    LD      C, $09
098F: C30500  	    JP      $0005
              	
0992: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
0996: 6B206973	
099A: 20656D70	
099E: 74792E5C	
09A2: 6E24    	
              	    .endlocal
              	
09A4:         	pop_stack_execute:
09A4: 2A380E  	    LD      HL, (STACK_POINTER)
09A7: 23      	    INC     HL                              ; skip the type
              	
09A8: 4E23462B	    LD      BC, (HL)                        ; load the string length
09AC: 23      	    INC     HL
09AD: 23      	    INC     HL
              	
09AE: 09      	    ADD     HL, BC                          ; calculate location after the string
              	
09AF: 22380E  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
09B2: C9      	    RET
              	    
              	    .include "stack/stack-concatenate.asm"
              	;; ===============================================================
              	;; Concatenates the two strings on the stack, replacing them with
              	;; the concatenation
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ===============================================================
09B3:         	stack_concatenate:
09B3: 2A360E  	    LD      HL, (STACK_BASE)
09B6: ED5B380E	    LD      DE, (STACK_POINTER)
09BA: ED52    	    SBC     HL, DE
09BC: 201A    	    JR      NZ, stack_concatenate_execute
              	
              	    .local
09BE: 11C609  	    LD      DE, ERROR
09C1: 0E09    	    LD      C, $09
09C3: C30500  	    JP      $0005
              	
09C6: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
09CA: 6B206973	
09CE: 20656D70	
09D2: 74792E5C	
09D6: 6E24    	
              	    .endlocal
              	
09D8:         	stack_concatenate_execute:
09D8: DD2A380E	    LD      IX, (STACK_POINTER)             ; second string
              	
09DC: 2A380E  	    LD      HL, (STACK_POINTER)
09DF: DD4E01  	    LD      BC, (IX + 1)                    ; string length
09E2: DD4602  	
09E5: 09      	    ADD     HL, BC
              	
09E6: 010300  	    LD      BC, 0x0003                      ; header length
09E9: 09      	    ADD     HL, BC
              	
09EA: E5      	    PUSH    HL
09EB: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
09ED: ED5B380E	    LD      DE, (STACK_POINTER)
09F1: 1B      	    DEC     DE
              	
              	; copy the second word
09F2: DD4E01  	    LD      BC, (IX + 1)                    ; count
09F5: DD4602  	
09F8: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
09FA: E1      	    POP     HL
09FB: 09      	    ADD     HL, BC
09FC: 23      	    INC     HL
09FD: 23      	    INC     HL
              	
09FE: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
0A00: FD4E01  	    LD      BC, (IY + 1)                    ; count
0A03: FD4602  	
0A06: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
0A08: E1      	    POP     HL
0A09: 09      	    ADD     HL, BC
0A0A: 23      	    INC     HL
0A0B: 23      	    INC     HL
              	
0A0C: EDB8    	    LDDR                                    ; copy second word down
              	
0A0E: 13      	    INC     DE                              ; point to the start of the new string
              	
0A0F: DD6E01  	    LD      HL, (IX + 1)
0A12: DD6602  	
0A15: FD4E01  	    LD      BC, (IY + 1)
0A18: FD4602  	
0A1B: 09      	    ADD     HL, BC
0A1C: 444D    	    LD      BC, HL                          ; combined length
              	
0A1E: D9      	    EXX
0A1F: CD7F09  	    CALL    pop_stack
0A22: CD7F09  	    CALL    pop_stack
0A25: D9      	    EXX
              	
0A26: CD6609  	    CALL    push_string
              	
0A29: C9      	    RET
              	    
              	
