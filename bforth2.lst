              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
018E:         	fill_memory:
018E: 77      	    LD      (HL), A                         ; set the first location
018F: 0B      	    DEC     BC
              	
0190: 54      	    LD      D, H                            ; set the next location as the destination
0191: 5D      	    LD      E, L
0192: 13      	    INC     DE
              	
0193: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
0195: C9      	    RET
              	    
