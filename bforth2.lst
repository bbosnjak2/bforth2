              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
0199:         	is_whitespace:
0199: FE20    	    CP      A, ASCII_SPACE
019B: C8      	    RET     Z
              	
019C: FE09    	    CP      A, ASCII_TAB
019E: C8      	    RET     Z
              	
019F: FE0D    	    CP      A, ASCII_CR
01A1: C8      	    RET     Z
              	
01A2: FE0A    	    CP      A, ASCII_LF
01A4: C8      	    RET     Z
              	
01A5: FE0C    	    CP      A, ASCII_FF
01A7: C8      	    RET     Z
              	
01A8: FE0B    	    CP      A, ASCII_VT
01AA: C8      	    RET     Z
              	
01AB: C9      	    RET
              	    
