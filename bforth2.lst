              	    .endlocal
              	    
              	    .include "dictionary/INLINE.asm"
              	;; ==========================================================
              	;; Prompts the user to input a line of text.  The line is
              	;; stored in the CURRENT_INPUT buffer.
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
077F:         	INLINE:
077F: CD9607  	    CALL    PROMPT
0782: CDDC08  	    CALL    system_load_input_buffer
0785: CDA908  	    CALL    system_copy_input_to_current_input
              	
0788: C9      	    RET
              	    
              	    .include "dictionary/PRINT-GREETING.asm"
              	;; ==========================================================
              	;; Prints the initial greeting
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0789:         	PRINT_GREETING
0789: CD5F08  	    CALL    WELCOME_TEXT
078C: CD0E07  	    CALL    DOT
078F: CD5007  	    CALL    HELP_PROMPT_TEXT
0792: CD0E07  	    CALL    DOT
0795: C9      	    RET
              	    
              	    .include "dictionary/PROMPT.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
0796:         	PROMPT
              	    .local
0796: 11A307  	    LD      DE, INPUT_PROMPT                ; content
0799: 010200  	    LD      BC, INPUT_PROMPT_LEN            ; length
079C: CDEE08  	    CALL    push_string
              	
079F: CD0E07  	    CALL    DOT
              	
07A2: C9      	    RET
              	
07A3: 3E20    	INPUT_PROMPT     DEFM    "> "
              	
0002:         	INPUT_PROMPT_LEN .equ    $ - INPUT_PROMPT
              	    .endlocal
              	    
              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07A5:         	RESET_STACK
07A5: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
07A8: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
07A9: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
07AC: ED42    	    SBC     HL, BC
              	
07AE: 22170E  	    LD      (STACK_BASE), HL
07B1: 22190E  	    LD      (STACK_POINTER), HL
              	
07B4: C9      	    RET
              	    
              	    .include "dictionary/START.asm"
              	;; ==========================================================
              	;; Starts (or restarts) the system
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07B5:         	START:
07B5: CDA507  	    CALL    RESET_STACK
07B8: CDFA06  	    CALL    CLEAR_SCREEN
07BB: CD8907  	    CALL    PRINT_GREETING
              	
07BE: C9      	    RET
              	    
              	    .include "dictionary/TOKEN.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and pushing it to the stack.  If no token is found then the stack
              	;; entry will have zero length.
              	;; IN:  -
              	;; OUT: -
              	;; MOD:
              	;; ==================================================================
07BF:         	TOKEN:
07BF: DD21BE0E	    LD      IX, CURRENT_INPUT_LEN
07C3: FD210E08	    LD      IY, CURRENT_TOKEN_LEN
              	
07C7: 210F08  	    LD      HL, CURRENT_TOKEN
07CA: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07CD: 3E00    	    LD      A, 0x00
07CF: FD360000	    LD      (IY), 0x00
07D3: CDD408  	    CALL    system_fill_memory
              	
07D6: 2AC00E  	    LD      HL, (CURRENT_INPUT_POS)
07D9: 110F08  	    LD      DE, CURRENT_TOKEN
              	
07DC:         	TOKEN_skip_whitespace:
07DC: DD7E01  	    LD      A, (IX + 1)                     ; CURRENT_INPUT_REMAINING_LEN
07DF: B7      	    OR      A
07E0: 281D    	    JR      Z, TOKEN_end_of_input
              	
07E2: 7E      	    LD      A, (HL)
              	
07E3: CD5B01  	    CALL    is_whitespace
07E6: 2006    	    JR      NZ, TOKEN_copy_token_loop
              	
07E8: 23      	    INC     HL
07E9: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
07EC: 18EE    	    JR      TOKEN_skip_whitespace
              	
07EE:         	TOKEN_copy_token_loop:
07EE: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
07EF: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
07F2: 23      	    INC     HL                              ; CURRENT_INPUT_POS
07F3: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
07F6: 2807    	    JR      Z, TOKEN_end_of_token
              	
07F8: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
07F9: 7E      	    LD      A, (HL)                         ; load the next character
07FA: CD5B01  	    CALL    is_whitespace
07FD: 20EF    	    JR      NZ, TOKEN_copy_token_loop
              	
07FF:         	TOKEN_end_of_input:
07FF:         	TOKEN_end_of_token:
07FF: 22C00E  	    LD      (CURRENT_INPUT_POS), HL
              	
0802:         	TOKEN_done:
0802: FD4E00  	    LD      C, (IY)                         ; CURRENT_INPUT_LEN
0805: 0600    	    LD      B, 0
0807: 110F08  	    LD      DE, CURRENT_TOKEN
080A: CDEE08  	    CALL    push_string
              	
080D: C9      	    RET
              	
080E: 00      	CURRENT_TOKEN_LEN DEFB    0
080F: 00000000	CURRENT_TOKEN     DEFS    (CURRENT_INPUT_MAX_LEN), 0
0813: 00...   	
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
              	;; ==========================================================
              	;; Pushes welcome text onto the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
085F:         	WELCOME_TEXT
              	    .local
085F: 116908  	    LD      DE, TEXT_GREETING_NL
0862: 011300  	    LD      BC, TEXT_GREETING_NL_LEN
0865: CDEE08  	    CALL    push_string
              	
0868: C9      	    RET
              	
0869: 57656C63	TEXT_GREETING_NL     DEFM    "Welcome to bforth2", 10
086D: 6F6D6520	
0871: 746F2062	
0875: 666F7274	
0879: 68320A  	
0013:         	TEXT_GREETING_NL_LEN .equ    $ - TEXT_GREETING_NL
              	
              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
087C:         	print:
087C: 1A      	    LD      A, (DE)
087D: B7      	    OR      A
087E: C8      	    RET     Z                               ; nothing to print
              	
087F: 3E00    	    LD      A, $00                          ; null terminator
0881: 62      	    LD      H, D                            ; copy the start address in HL
0882: 6B      	    LD      L, E
              	
0883:         	print_find_null_terminator_loop:
0883: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0885: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0887: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0888: 3E24    	    LD      A, '$'
088A: 77      	    LD      (HL), A
              	
088B: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
088C: 0E09    	    LD      C, $09                          ; invoke the CPM print method
088E: CD0500  	    CALL    $0005
              	
0891: E1      	    POP     HL                              ; restore HL and put the null terminator back
0892: 3E00    	    LD      A, $00
0894: 77      	    LD      (HL), A
              	
0895: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0896:         	print_char:
0896: 5F      	    LD      E, A
0897: 0E02    	    LD      C, F_CONSOLE_OUT
0899: CD0500  	    CALL    BDOS
              	
089C: C9      	    RET
              	    
              	
              	    .include "system/system-clear-input-buffer.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
089D:         	system_clear_input_buffer
089D: 211D0E  	    LD      HL, INPUT_BUFFER
08A0: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
