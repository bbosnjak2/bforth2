0F34: 3B0F    	WORD_LIST_NEXT:             DEFW    WORD_LIST_END + 1 ; points to where the next new word will be stored
              	
              	; Structure:
              	;LENGTH: DEFB    3
              	;NEXT:   DEFW    WORD_LIST_END
              	;THIS:   DEFW    WORD
              	;WORD:   DEFM    "Abc", 0
              	
0F36: 0000    	WORD_LIST_CHECKPOINT_HEAD:  DEFW    0x0000
0F38: 0000    	WORD_LIST_CHECKPOINT_NEXT:  DEFW    0x0000
              	
0F3A: 00      	WORD_LIST_END:              DEFB    0
              	    


