094F: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
0950:         	parse_token:
0950: DD21480E	    LD      IX, CURRENT_INPUT_LEN
0954: FD214C0E	    LD      IY, CURRENT_TOKEN_LEN
              	
0958: 214D0E  	    LD      HL, CURRENT_TOKEN
095B: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
095E: 3E00    	    LD      A, 0x00
0960: FD360000	    LD      (IY), 0x00
0964: CD5301  	    CALL    fill_memory
              	
0967: 2A4A0E  	    LD      HL, (CURRENT_INPUT_POS)
096A: 114D0E  	    LD      DE, CURRENT_TOKEN
              	
