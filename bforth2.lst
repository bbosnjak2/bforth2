              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
077E:         	PROMPT
              	    .local
077E: 118B07  	    LD      DE, INPUT_PROMPT                ; content
0781: 010200  	    LD      BC, INPUT_PROMPT_LEN            ; length
0784: CD3608  	    CALL    push_string
              	
