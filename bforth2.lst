06F9: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
06FC: CD3608  	    CALL    push_string
              	
06FF: CD0A07  	    CALL    DOT
              	
0702: C9      	    RET
              	
0703:         	CLEAR_SCREEN_SEQ     DEFL    $
0703: 1B      	    .byte   27
0704: 5B324A  	    .ascii  "[2J"
0707: 1B      	    .byte   27
0708: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
070A:         	DOT
070A: 2AA90D  	    LD      HL, (STACK_BASE)
070D: ED5BAB0D	    LD      DE, (STACK_POINTER)
0711: ED52    	    SBC     HL, DE
0713: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0715: 111D07  	    LD      DE, ERROR
0718: 0E09    	    LD      C, $09
071A: C30500  	    JP      $0005
              	
071D: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
0721: 6B206973	
0725: 20656D70	
0729: 74792E5C	
072D: 6E24    	
              	    .endlocal
              	
072F:         	DOT_push_terminator:
              	    .local
072F: 113A07  	    LD      DE, TERMINATOR                  ; content
0732: 010100  	    LD      BC, 0x01                        ; length
0735: CD3608  	    CALL    push_string
0738: 1801    	    JR      DOT_concatenate
              	
073A: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
073B:         	DOT_concatenate:
073B: CD8008  	    CALL    stack_concatenate
              	
073E:         	DOT_print:
073E: ED5BAB0D	    LD      DE, (STACK_POINTER)
0742: 13      	    INC     DE                              ; type byte
0743: 13      	    INC     DE                              ; length word
0744: 13      	    INC     DE
              	
0745: CD2901  	    CALL    bdos_print_string
              	
0748: CD4C08  	    CALL    pop_stack
              	
074B: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
