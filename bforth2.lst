              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0781:         	clear_input_buffer
0781: 219B0D  	    LD      HL, INPUT_BUFFER
0784: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
0787: 3E00    	    LD      A, 0x00
              	
0789: CD4D01  	    CALL    fill_memory
              	
078C: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
078D:         	load_input_buffer
078D: CD8107  	    CALL    clear_input_buffer
              	
0790: 11990D  	    LD      DE, INPUT_BUFFER_SIZE
0793: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0795: 12      	    LD      (DE), A
              	
0796: 0E0A    	    LD      C, $0A
0798: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
079B: 1E0A    	    LD      E, ASCII_LF
079D: 0E02    	    LD      C, $02
079F: CD0500  	    CALL    $0005
              	
07A2: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07A3:         	copy_input_to_current_input:
07A3: 21EC0D  	    LD      HL, CURRENT_INPUT
07A6: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07A9: 3E00    	    LD      A, 0x00
07AB: CD4D01  	    CALL    fill_memory
              	
07AE: DD213C0E	    LD      IX, CURRENT_INPUT_LEN
              	
07B2: 219B0D  	    LD      HL, INPUT_BUFFER                ; source
07B5: 11EC0D  	    LD      DE, CURRENT_INPUT               ; destination
07B8: ED533E0E	    LD      (CURRENT_INPUT_POS), DE
              	
07BC: 3A9A0D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
07BF: 0600    	    LD      B, 0x00
07C1: 4F      	    LD      C, A
07C2: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
07C5: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
07C8: B7      	    OR      A                               ; skip if nothing was input
07C9: 2802    	    JR      Z, copy_input_to_current_input_done
              	
07CB: EDB0    	    LDIR                                    ; copy
              	
07CD:         	copy_input_to_current_input_done:
07CD: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/reset-stack.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07CE:         	reset_stack:
07CE: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
07D1: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
07D2: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
07D5: ED42    	    SBC     HL, BC
              	
07D7: 22950D  	    LD      (STACK_BASE), HL
07DA: 22970D  	    LD      (STACK_POINTER), HL
              	
07DD: C9      	    RET
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
07DE:         	push_string:
07DE: 2A970D  	    LD      HL, (STACK_POINTER)
07E1: ED42    	    SBC     HL, BC
              	
07E3: 2B      	    DEC     HL                              ; 2 bytes for length
07E4: 2B      	    DEC     HL
07E5: 2B      	    DEC     HL                              ; 1 byte for type
              	
07E6: 22970D  	    LD      (STACK_POINTER), HL
              	
07E9: 3601    	    LD      (HL), STACK_STRING_TYPE
07EB: 23      	    INC     HL
              	
07EC: 71      	    LD      (HL), C
07ED: 23      	    INC     HL
07EE: 70      	    LD      (HL), B
07EF: 23      	    INC     HL
              	
07F0: EB      	    EX      DE, HL
07F1: EDB0    	    LDIR
              	
07F3: C9      	    RET
              	    
              	    .include "stack/pop-stack.asm"
              	;; ==========================================================
              	;; Pops the top item from the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07F4:         	pop_stack:
07F4: 2A950D  	    LD      HL, (STACK_BASE)
07F7: ED5B970D	    LD      DE, (STACK_POINTER)
07FB: ED52    	    SBC     HL, DE
07FD: 201A    	    JR      NZ, pop_stack_execute
              	
              	    .local
07FF: 110708  	    LD      DE, ERROR
0802: 0E09    	    LD      C, $09
0804: C30500  	    JP      $0005
              	
0807: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
080B: 6B206973	
080F: 20656D70	
0813: 74792E5C	
0817: 6E24    	
              	    .endlocal
              	
0819:         	pop_stack_execute:
0819: 2A970D  	    LD      HL, (STACK_POINTER)
081C: 23      	    INC     HL                              ; skip the type
              	
081D: 4E23462B	    LD      BC, (HL)                        ; load the string length
0821: 23      	    INC     HL
0822: 23      	    INC     HL
              	
0823: 09      	    ADD     HL, BC                          ; calculate location after the string
              	
0824: 22970D  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
0827: C9      	    RET
              	    
              	    .include "stack/stack-concatenate.asm"
              	;; ===============================================================
              	;; Concatenates the two strings on the stack, replacing them with
              	;; the concatenation
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ===============================================================
0828:         	stack_concatenate:
0828: 2A950D  	    LD      HL, (STACK_BASE)
082B: ED5B970D	    LD      DE, (STACK_POINTER)
082F: ED52    	    SBC     HL, DE
0831: 201A    	    JR      NZ, stack_concatenate_execute
              	
              	    .local
0833: 113B08  	    LD      DE, ERROR
0836: 0E09    	    LD      C, $09
0838: C30500  	    JP      $0005
              	
083B: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
083F: 6B206973	
0843: 20656D70	
0847: 74792E5C	
084B: 6E24    	
              	    .endlocal
              	
084D:         	stack_concatenate_execute:
084D: DD2A970D	    LD      IX, (STACK_POINTER)             ; second string
              	
0851: 2A970D  	    LD      HL, (STACK_POINTER)
0854: DD4E01  	    LD      BC, (IX + 1)                    ; string length
0857: DD4602  	
085A: 09      	    ADD     HL, BC
              	
085B: 010300  	    LD      BC, 0x0003                      ; header length
085E: 09      	    ADD     HL, BC
              	
085F: E5      	    PUSH    HL
0860: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
0862: ED5B970D	    LD      DE, (STACK_POINTER)
0866: 1B      	    DEC     DE
              	
              	; copy the second word
0867: DD4E01  	    LD      BC, (IX + 1)                    ; count
086A: DD4602  	
086D: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
086F: E1      	    POP     HL
0870: 09      	    ADD     HL, BC
0871: 23      	    INC     HL
0872: 23      	    INC     HL
              	
