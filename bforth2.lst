              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
06F2:         	CLEAR_SCREEN
              	    .local
06F2: 11FF06  	    LD      DE, CLEAR_SCREEN_SEQ            ; content
06F5: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
06F8: CD2E08  	    CALL    push_string
              	
06FB: CD0607  	    CALL    DOT
              	
06FE: C9      	    RET
              	
06FF:         	CLEAR_SCREEN_SEQ     DEFL    $
06FF: 1B      	    .byte   27
0700: 5B324A  	    .ascii  "[2J"
0703: 1B      	    .byte   27
0704: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0706:         	DOT
0706: 2AA10D  	    LD      HL, (STACK_BASE)
0709: ED5BA30D	    LD      DE, (STACK_POINTER)
070D: ED52    	    SBC     HL, DE
070F: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0711: 111907  	    LD      DE, ERROR
0714: 0E09    	    LD      C, $09
0716: C30500  	    JP      $0005
              	
0719: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
071D: 6B206973	
0721: 20656D70	
0725: 74792E5C	
0729: 6E24    	
              	    .endlocal
              	
072B:         	DOT_push_terminator:
              	    .local
072B: 113607  	    LD      DE, TERMINATOR                  ; content
072E: 010100  	    LD      BC, 0x01                        ; length
0731: CD2E08  	    CALL    push_string
0734: 1801    	    JR      DOT_concatenate
              	
0736: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
0737:         	DOT_concatenate:
0737: CD7808  	    CALL    stack_concatenate
              	
073A:         	DOT_print:
073A: ED5BA30D	    LD      DE, (STACK_POINTER)
073E: 13      	    INC     DE                              ; type byte
073F: 13      	    INC     DE                              ; length word
0740: 13      	    INC     DE
              	
0741: CD1D01  	    CALL    bdos_print_string
              	
0744: CD4408  	    CALL    pop_stack
              	
0747: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
              	;; ==========================================================
