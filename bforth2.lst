097A: DD4602  	
097D: 09      	    ADD     HL, BC
              	
097E: 010300  	    LD      BC, 0x0003                      ; header length
0981: 09      	    ADD     HL, BC
              	
0982: E5      	    PUSH    HL
0983: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
0985: ED5B290E	    LD      DE, (STACK_POINTER)
0989: 1B      	    DEC     DE
              	
              	; copy the second word
098A: DD4E01  	    LD      BC, (IX + 1)                    ; count
098D: DD4602  	
