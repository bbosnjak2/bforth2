              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
0196:         	is_whitespace:
0196: FE20    	    CP      A, ASCII_SPACE
0198: C8      	    RET     Z
              	
