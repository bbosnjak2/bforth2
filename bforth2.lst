              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0702:         	DOT
0702: 2AA10D  	    LD      HL, (STACK_BASE)
0705: ED5BA30D	    LD      DE, (STACK_POINTER)
0709: ED52    	    SBC     HL, DE
070B: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
070D: 111507  	    LD      DE, ERROR
0710: 0E09    	    LD      C, $09
0712: C30500  	    JP      $0005
              	
0715: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
0719: 6B206973	
071D: 20656D70	
0721: 74792E5C	
0725: 6E24    	
              	    .endlocal
              	
0727:         	DOT_push_terminator:
              	    .local
0727: 113207  	    LD      DE, TERMINATOR                  ; content
072A: 010100  	    LD      BC, 0x01                        ; length
072D: CD2E08  	    CALL    push_string
0730: 1801    	    JR      DOT_concatenate
              	
0732: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
0733:         	DOT_concatenate:
0733: CD7808  	    CALL    stack_concatenate
              	
0736:         	DOT_print:
0736: ED5BA30D	    LD      DE, (STACK_POINTER)
073A: 13      	    INC     DE                              ; type byte
073B: 13      	    INC     DE                              ; length word
073C: 13      	    INC     DE
              	
073D: CD2101  	    CALL    bdos_print_string
              	
0740: CD4408  	    CALL    pop_stack
              	
0743: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
