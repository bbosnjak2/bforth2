08DB: B7      	    OR      A
08DC: 283D    	    JR      Z, add_command_syntax_error
              	
08DE: 2A390D  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
08E1: 7E      	    LD      A, (HL)
08E2: B7      	    OR      A
08E3: 2036    	    JR      NZ, add_command_syntax_error
              	
08E5:         	add_command_write_word_text:
08E5: DD2A1B0E	    LD      IX, (WORD_LIST_NEXT)
              	
08E9: 78      	    LD      A, B                            ; write the number of characters (excludes the null terminator)
08EA: DD7700  	    LD      (IX + 0), A
              	
08ED: 2A190E  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
08F0: DD7501  	    LD      (IX + 1), HL
08F3: DD7402  	
              	
08F6: C5      	    PUSH    BC                              ; save the number of characters value that's in B
              	
08F7: 2A1B0E  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
08FA: 110500  	    LD      DE, 5                           ; offset HL to the location to write the word itself
08FD: 19      	    ADD     HL, DE
              	
08FE: DD7503  	    LD      (IX + 3), HL                    ; update the header with the location where the text will be copied to
0901: DD7404  	
              	
0904: EB      	    EX      DE, HL                          ; update DE to be the destination pointed to by HL
0905: 213C0D  	    LD      HL, CURRENT_TOKEN               ; HL is the source
              	
0908: 48      	    LD      C, B
0909: 0600    	    LD      B, 0x00
090B: 03      	    INC     BC                              ; copy the null terminated, too
              	
090C: EDB0    	    LDIR                                    ; write the word, DE will be the new WORD_LIST_NEXT value
              	
090E: C1      	    POP     BC                              ; restore the number of characters value in B
              	
