              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
07C4:         	print:
07C4: 1A      	    LD      A, (DE)
07C5: B7      	    OR      A
07C6: C8      	    RET     Z                               ; nothing to print
              	
07C7: 3E00    	    LD      A, $00                          ; null terminator
07C9: 62      	    LD      H, D                            ; copy the start address in HL
07CA: 6B      	    LD      L, E
              	
07CB:         	print_find_null_terminator_loop:
07CB: EDA1    	    CPI                                     ; compare (HL) to a null terminator
07CD: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
07CF: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
07D0: 3E24    	    LD      A, '$'
07D2: 77      	    LD      (HL), A
              	
07D3: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
07D4: 0E09    	    LD      C, $09                          ; invoke the CPM print method
07D6: CD0500  	    CALL    $0005
              	
07D9: E1      	    POP     HL                              ; restore HL and put the null terminator back
07DA: 3E00    	    LD      A, $00
07DC: 77      	    LD      (HL), A
              	
07DD: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
07DE:         	print_char:
07DE: 5F      	    LD      E, A
07DF: 0E02    	    LD      C, F_CONSOLE_OUT
07E1: CD0500  	    CALL    BDOS
              	
07E4: C9      	    RET
              	    
              	
              	    .include "system/system-clear-input-buffer.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07E5:         	system_clear_input_buffer
07E5: 21AF0D  	    LD      HL, INPUT_BUFFER
07E8: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
07EB: 3E00    	    LD      A, 0x00
              	
07ED: CDF107  	    CALL    system_fill_memory
              	
07F0: C9      	    RET
              	    
              	    .include "system/system-fill-memory.asm"
              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
07F1:         	system_fill_memory:
07F1: 77      	    LD      (HL), A                         ; set the first location
07F2: 0B      	    DEC     BC
              	
07F3: 54      	    LD      D, H                            ; set the next location as the destination
07F4: 5D      	    LD      E, L
07F5: 13      	    INC     DE
              	
07F6: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
07F8: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;; ==========================================================
07F9:         	system_load_input_buffer
07F9: CDE507  	    CALL    system_clear_input_buffer
              	
07FC: 11AD0D  	    LD      DE, INPUT_BUFFER_SIZE
07FF: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0801: 12      	    LD      (DE), A
              	
0802: CD1D01  	    CALL    bdos_line_input
              	
              	; echo a LF since BDOS doesn't
0805: 1E0A    	    LD      E, ASCII_LF
0807: CD2301  	    CALL    bdos_print_char
              	
080A: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
080B:         	copy_input_to_current_input:
080B: 21000E  	    LD      HL, CURRENT_INPUT
080E: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
0811: 3E00    	    LD      A, 0x00
0813: CDF107  	    CALL    system_fill_memory
              	
0816: DD21500E	    LD      IX, CURRENT_INPUT_LEN
              	
081A: 21AF0D  	    LD      HL, INPUT_BUFFER                ; source
081D: 11000E  	    LD      DE, CURRENT_INPUT               ; destination
0820: ED53520E	    LD      (CURRENT_INPUT_POS), DE
              	
0824: 3AAE0D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
0827: 0600    	    LD      B, 0x00
0829: 4F      	    LD      C, A
082A: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
082D: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
0830: B7      	    OR      A                               ; skip if nothing was input
0831: 2802    	    JR      Z, copy_input_to_current_input_done
              	
0833: EDB0    	    LDIR                                    ; copy
              	
0835:         	copy_input_to_current_input_done:
0835: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
0836:         	push_string:
0836: 2AAB0D  	    LD      HL, (STACK_POINTER)
0839: ED42    	    SBC     HL, BC
              	
083B: 2B      	    DEC     HL                              ; 2 bytes for length
083C: 2B      	    DEC     HL
083D: 2B      	    DEC     HL                              ; 1 byte for type
              	
083E: 22AB0D  	    LD      (STACK_POINTER), HL
              	
0841: 3601    	    LD      (HL), STACK_STRING_TYPE
0843: 23      	    INC     HL
              	
