06EF: 1B      	    .byte   27
06F0: 5B324A  	    .ascii  "[2J"
06F3: 1B      	    .byte   27
06F4: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
