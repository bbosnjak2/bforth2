0002:         	INPUT_PROMPT_LEN .equ    $ - INPUT_PROMPT
              	    .endlocal
              	    
              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
078D:         	RESET_STACK
078D: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
0790: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
0791: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
0794: ED42    	    SBC     HL, BC
              	
0796: 22A90D  	    LD      (STACK_BASE), HL
0799: 22AB0D  	    LD      (STACK_POINTER), HL
              	
079C: C9      	    RET
              	    
              	    .include "dictionary/START.asm"
