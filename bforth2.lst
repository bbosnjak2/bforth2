0013:         	TEXT_GREETING_NL_LEN .equ    $ - TEXT_GREETING_NL
              	
              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
088C:         	print:
088C: 1A      	    LD      A, (DE)
088D: B7      	    OR      A
088E: C8      	    RET     Z                               ; nothing to print
              	
088F: 3E00    	    LD      A, $00                          ; null terminator
0891: 62      	    LD      H, D                            ; copy the start address in HL
0892: 6B      	    LD      L, E
              	
0893:         	print_find_null_terminator_loop:
0893: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0895: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0897: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0898: 3E24    	    LD      A, '$'
089A: 77      	    LD      (HL), A
              	
089B: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
089C: 0E09    	    LD      C, $09                          ; invoke the CPM print method
089E: CD0500  	    CALL    $0005
              	
08A1: E1      	    POP     HL                              ; restore HL and put the null terminator back
08A2: 3E00    	    LD      A, $00
08A4: 77      	    LD      (HL), A
              	
08A5: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
08A6:         	print_char:
08A6: 5F      	    LD      E, A
08A7: 0E02    	    LD      C, F_CONSOLE_OUT
