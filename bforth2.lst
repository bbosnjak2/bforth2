              	    .include "output/clear-screen.cpm.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0716:         	clear_screen
0716: 111F07  	    LD      DE, CLEAR_SCREEN_SEQ
0719: 0E09    	    LD      C, $09
071B: CD0500  	    CALL    $0005
              	
071E: C9      	    RET
              	
071F:         	CLEAR_SCREEN_SEQ    DEFL    $
071F: 1B      	    .byte   27
0720: 5B324A  	    .ascii  "[2J"
0723: 1B      	    .byte   27
0724: 5B48    	    .ascii  "[H"
0726: 24      	    .ascii  "$"
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
0727:         	print:
0727: 1A      	    LD      A, (DE)
0728: B7      	    OR      A
0729: C8      	    RET     Z                               ; nothing to print
              	
072A: 3E00    	    LD      A, $00                          ; null terminator
072C: 62      	    LD      H, D                            ; copy the start address in HL
072D: 6B      	    LD      L, E
              	
072E:         	print_find_null_terminator_loop:
072E: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0730: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0732: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0733: 3E24    	    LD      A, '$'
0735: 77      	    LD      (HL), A
              	
0736: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
0737: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0739: CD0500  	    CALL    $0005
              	
073C: E1      	    POP     HL                              ; restore HL and put the null terminator back
073D: 3E00    	    LD      A, $00
073F: 77      	    LD      (HL), A
              	
0740: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0741:         	print_char:
0741: 5F      	    LD      E, A
0742: 0E02    	    LD      C, F_CONSOLE_OUT
0744: CD0500  	    CALL    BDOS
              	
0747: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE
              	;; ==========================================================
0748:         	prompt
0748: 115B01  	    LD      DE, INPUT_PROMPT_SP
074B: CD2707  	    CALL    print
              	
074E: C9      	    RET
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
074F:         	clear_input_buffer
074F: 21D90B  	    LD      HL, INPUT_BUFFER
0752: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
0755: 3E00    	    LD      A, 0x00
              	
0757: CD7B01  	    CALL    fill_memory
              	
075A: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
075B:         	load_input_buffer
075B: CD4F07  	    CALL    clear_input_buffer
              	
075E: 11D70B  	    LD      DE, INPUT_BUFFER_SIZE
0761: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0763: 12      	    LD      (DE), A
              	
0764: 0E0A    	    LD      C, $0A
0766: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
0769: 1E0A    	    LD      E, ASCII_LF
076B: 0E02    	    LD      C, $02
076D: CD0500  	    CALL    $0005
              	
0770: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input, with null
              	;; termination
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0771:         	COPY_INPUT_TO_CURRENT_INPUT:
0771: 21D90B  	    LD      HL, INPUT_BUFFER
0774: 112A0C  	    LD      DE, CURRENT_INPUT
0777: 3AD80B  	    LD      A, (INPUT_BUFFER_COUNT)
              	
077A: B7      	    OR      A                               ; skip if nothing was input
077B: 2805    	    JR      Z, COPY_INPUT_TO_CURRENT_INPUT_RESTORE_NULL
              	
077D: 0600    	    LD      B, 0                            ; load BC with the number of bytes that were input
077F: 4F      	    LD      C, A
              	
0780: EDB0    	    LDIR
              	
0782:         	COPY_INPUT_TO_CURRENT_INPUT_RESTORE_NULL:
0782: 3E00    	    LD      A, 0x00                         ; write terminating null
0784: 12      	    LD      (DE), A
              	
0785: C9      	    RET
              	    
              	
              	    .include "command-processor/process-current-input.asm"
              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
0786:         	process_current_input:
              	
0786: 212A0C  	    LD      HL, CURRENT_INPUT
0789: 227B0C  	    LD      (CURRENT_INPUT_POS), HL         ; initialize the position at the start
              	
078C: CDE207  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
078F: 217D0C  	    LD      HL, CURRENT_TOKEN
0792: CD9B04  	    CALL    to_uppercase
              	
0795: CDA907  	    CALL    find_command_method_address
              	
0798: 280D    	    JR      Z, process_current_input_command_recognized
              	
079A:         	process_current_input_command_not_recognized:
079A: 117D0C  	    LD      DE, CURRENT_TOKEN
079D: CD2707  	    CALL    print
07A0: 116201  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
07A3: CD2707  	    CALL    print
07A6: C9      	    RET
              	
07A7:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
07A7: E9      	    JP      HL
              	
07A8:         	process_current_input_done:
07A8: C9      	    RET
              	
              	    .include "find-command-method-address.asm"
              	;; ==================================================================
              	;; Finds the command in CURRENT_COMMAND in the command list.
              	;; IN:  B  = number of characters in the command
              	;; OUT: HL = address of command method
              	;;      Z = set if command found (NZ if not found)
              	;; MOD: A, C, HL, DE, IX
              	;; ==========================================================
07A9:         	find_command_method_address:
              	
07A9: DD21B404	    LD      IX, COMMAND_LIST
              	
07AD:         	find_command_method_address_check_command:
07AD: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
07B0: B7      	    OR      A                               ; if 0, then end of list reached
07B1: 282B    	    JR      Z, find_command_method_address_not_found
              	
07B3: B8      	    CP      B                               ; if the length differs, move to the next command
07B4: 200E    	    JR      NZ, find_command_method_address_next_command
              	
07B6:         	find_command_method_address_compare:
07B6: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
07B9: DD6604  	
07BC: 117D0C  	    LD      DE, CURRENT_TOKEN
07BF: 48      	    LD      C, B                            ; number of characters
              	
07C0:         	find_command_method_address_compare_loop:
07C0: 1A      	    LD      A, (DE)
07C1: BE      	    CP      (HL)
07C2: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
07C4:         	find_command_method_address_next_command:
07C4: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
07C7: DD6601  	
07CA: E5      	    PUSH    HL
07CB: DDE1    	    POP     IX
07CD: 18DE    	    JR      find_command_method_address_check_command
              	
07CF:         	find_command_method_address_compare_next_character:
07CF: 23      	    INC     HL
07D0: 13      	    INC     DE
07D1: 0D      	    DEC     C                               ; move to next character
07D2: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
07D4:         	find_command_method_address_found:          ; all characters have matched
07D4: DD6E09  	    LD      HL, (IX + COMMAND_METHOD_ADDRESS)
07D7: DD660A  	
07DA: 3E00    	    LD      A, $00
07DC: B7      	    OR      A                               ; clears the Z flag
07DD: C9      	    RET
              	
07DE:         	find_command_method_address_not_found:
07DE: 3E01    	    LD      A, $01
07E0: B7      	    OR      A                               ; sets the Z flag
              	
07E1: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN, null-terminated.  The B
              	;; register contains the number of characters (i.e. excludes the null
              	;; terminator).
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-token
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
07E2:         	parse_token:
              	
07E2: 2A7B0C  	    LD      HL, (CURRENT_INPUT_POS)
07E5: 117D0C  	    LD      DE, CURRENT_TOKEN
07E8: 0600    	    LD      B, $00                          ; number of characters in the token
              	
07EA: CD8E04  	    CALL    skip_whitespace
              	
07ED:         	parse_token_copy_token_loop:
07ED: 7E      	    LD      A, (HL)                         ; A contains the character
07EE: B7      	    OR      A
07EF: 280B    	    JR      Z, parse_token_end_of_input
              	
07F1: CD8301  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
07F4: 2806    	    JR      Z, parse_token_end_of_token
              	
07F6:         	parse_token_copy_character:
07F6: 12      	    LD      (DE), A
              	
07F7: 04      	    INC     B
07F8: 23      	    INC     HL
07F9: 13      	    INC     DE
              	
07FA: 18F1    	    JR      parse_token_copy_token_loop
              	
07FC:         	parse_token_end_of_input:
07FC:         	parse_token_end_of_token:
07FC: 3E00    	    LD      A, $00
07FE: 12      	    LD      (DE), A                         ; add null terminator
              	
07FF: CD8E04  	    CALL    skip_whitespace                 ; advance the current input pos to the next non-whitespace character
0802: 227B0C  	    LD      (CURRENT_INPUT_POS), HL
              	
0805:         	parse_token_done:
0805: C9      	    RET
              	    
              	    .include "command-processor/commands/help-command.asm"
              	;; ==================================================================
              	;; Displays help.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
0806:         	help_command:
0806: 2A7B0C  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
0809: 7E      	    LD      A, (HL)
080A: B7      	    OR      A
080B: 2807    	    JR      Z, help_command_execute
              	
080D:         	help_command_syntax_error:
080D: 116B01  	    LD      DE, SYNTAX_ERROR_NL
0810: CD2707  	    CALL    print
              	
0813: C9      	    RET
              	
0814:         	help_command_execute:
0814: DD21B404	    LD      IX, COMMAND_LIST
              	
0818:         	help_command_loop:
0818: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
081B: B7      	    OR      A                               ; if 0, then end of list reached
081C: 2829    	    JR      Z, help_command_done
              	
081E: DD5E05  	    LD      DE, (IX + COMMAND_SYNTAX)
0821: DD5606  	
