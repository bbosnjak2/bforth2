0B77:         	save_command_execute:
0B77:         	save_command_prepare_index:                 ; create index of word list entries
0B77: 2AAC0D  	    LD      HL, (WORD_LIST_NEXT)            ; start the index where the next new word would go
0B7A: 11B20D  	    LD      DE, WORD_LIST_END               ; location of the end of the word list
0B7D: 7323722B	    LD      (HL), DE                        ; write this end address as the first entry in the index
              	
0B81: DD2AAA0D	    LD      IX, (WORD_LIST_HEAD)            ; start IX at the head of the word list
              	
0B85: DD7E00  	    LD      A, (IX)
0B88: B7      	    OR      A
0B89: 201C    	    JR      NZ, save_command_prepare_index_loop
              	
