              	    .endlocal
              	    
              	    .include "dictionary/RESET-STACK.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0797:         	RESET_STACK
0797: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
079A: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
079B: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
079E: ED42    	    SBC     HL, BC
              	
07A0: 22A90D  	    LD      (STACK_BASE), HL
07A3: 22AB0D  	    LD      (STACK_POINTER), HL
              	
07A6: C9      	    RET
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
              	;; ==========================================================
              	;; Pushes welcome text onto the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07A7:         	WELCOME_TEXT
              	    .local
07A7: 11B107  	    LD      DE, TEXT_GREETING_NL
07AA: 011300  	    LD      BC, TEXT_GREETING_NL_LEN
07AD: CD3608  	    CALL    push_string
              	
07B0: C9      	    RET
              	
07B1: 57656C63	TEXT_GREETING_NL     DEFM    "Welcome to bforth2", 10
07B5: 6F6D6520	
07B9: 746F2062	
