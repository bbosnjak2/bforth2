              	;; MOD: A, B, C, HL, DE, IX
              	;; ==========================================================
0913:         	find_command_method_address:
0913: DD219004	    LD      IX, COMMAND_LIST
0917: 3A4C0E  	    LD      A, (CURRENT_TOKEN_LEN)
091A: 47      	    LD      B, A
              	
