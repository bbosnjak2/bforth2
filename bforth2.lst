              	    .include "output/clear-screen.cpm.asm"
              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
073C:         	clear_screen
              	    .local
073C: 114907  	    LD      DE, CLEAR_SCREEN_SEQ            ; content
073F: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_END - CLEAR_SCREEN_SEQ ; length
0742: CDDD07  	    CALL    push_string
              	
0745: CD9E08  	    CALL    dot
              	
0748: C9      	    RET
              	
0749:         	CLEAR_SCREEN_SEQ     DEFL    $
0749: 1B      	    .byte   27
074A: 5B324A  	    .ascii  "[2J"
074D: 1B      	    .byte   27
074E: 5B48    	    .ascii  "[H"
              	
0750:         	CLEAR_SCREEN_SEQ_END DEFL    $
              	    .endlocal
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
0750:         	print:
0750: 1A      	    LD      A, (DE)
0751: B7      	    OR      A
0752: C8      	    RET     Z                               ; nothing to print
              	
0753: 3E00    	    LD      A, $00                          ; null terminator
0755: 62      	    LD      H, D                            ; copy the start address in HL
0756: 6B      	    LD      L, E
              	
0757:         	print_find_null_terminator_loop:
0757: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0759: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
075B: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
075C: 3E24    	    LD      A, '$'
075E: 77      	    LD      (HL), A
              	
075F: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
0760: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0762: CD0500  	    CALL    $0005
              	
0765: E1      	    POP     HL                              ; restore HL and put the null terminator back
0766: 3E00    	    LD      A, $00
0768: 77      	    LD      (HL), A
              	
0769: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
076A:         	print_char:
076A: 5F      	    LD      E, A
076B: 0E02    	    LD      C, F_CONSOLE_OUT
076D: CD0500  	    CALL    BDOS
              	
0770: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE, BC
              	;; ==========================================================
0771:         	prompt
              	    .local
0771: 117E07  	    LD      DE, INPUT_PROMPT                ; content
0774: 010200  	    LD      BC, 0x02                        ; length
0777: CDDD07  	    CALL    push_string
              	
077A: CD9E08  	    CALL    dot
              	
077D: C9      	    RET
              	
077E: 3E20    	INPUT_PROMPT        DEFM    "> "
              	    .endlocal
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0780:         	clear_input_buffer
0780: 219A0D  	    LD      HL, INPUT_BUFFER
0783: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
0786: 3E00    	    LD      A, 0x00
              	
0788: CD9D01  	    CALL    fill_memory
              	
078B: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
078C:         	load_input_buffer
078C: CD8007  	    CALL    clear_input_buffer
              	
078F: 11980D  	    LD      DE, INPUT_BUFFER_SIZE
0792: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0794: 12      	    LD      (DE), A
              	
0795: 0E0A    	    LD      C, $0A
0797: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
079A: 1E0A    	    LD      E, ASCII_LF
079C: 0E02    	    LD      C, $02
079E: CD0500  	    CALL    $0005
              	
07A1: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07A2:         	copy_input_to_current_input:
07A2: 21EB0D  	    LD      HL, CURRENT_INPUT
07A5: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07A8: 3E00    	    LD      A, 0x00
07AA: CD9D01  	    CALL    fill_memory
              	
07AD: DD213B0E	    LD      IX, CURRENT_INPUT_LEN
              	
07B1: 219A0D  	    LD      HL, INPUT_BUFFER                ; source
07B4: 11EB0D  	    LD      DE, CURRENT_INPUT               ; destination
07B7: ED533D0E	    LD      (CURRENT_INPUT_POS), DE
              	
07BB: 3A990D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
07BE: 0600    	    LD      B, 0x00
07C0: 4F      	    LD      C, A
07C1: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
07C4: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
07C7: B7      	    OR      A                               ; skip if nothing was input
07C8: 2802    	    JR      Z, copy_input_to_current_input_done
              	
07CA: EDB0    	    LDIR                                    ; copy
              	
07CC:         	copy_input_to_current_input_done:
07CC: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/reset-stack.asm"
              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07CD:         	reset_stack:
07CD: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
07D0: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
07D1: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
07D4: ED42    	    SBC     HL, BC
              	
07D6: 22940D  	    LD      (STACK_BASE), HL
07D9: 22960D  	    LD      (STACK_POINTER), HL
              	
07DC: C9      	    RET
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
07DD:         	push_string:
07DD: 2A960D  	    LD      HL, (STACK_POINTER)
07E0: ED42    	    SBC     HL, BC
              	
07E2: 2B      	    DEC     HL                              ; 2 bytes for length
07E3: 2B      	    DEC     HL
07E4: 2B      	    DEC     HL                              ; 1 byte for type
              	
07E5: 22960D  	    LD      (STACK_POINTER), HL
              	
07E8: 3601    	    LD      (HL), STACK_STRING_TYPE
07EA: 23      	    INC     HL
              	
07EB: 71      	    LD      (HL), C
07EC: 23      	    INC     HL
07ED: 70      	    LD      (HL), B
07EE: 23      	    INC     HL
              	
07EF: EB      	    EX      DE, HL
07F0: EDB0    	    LDIR
              	
07F2: C9      	    RET
              	    
              	    .include "stack/pop-stack.asm"
              	;; ==========================================================
              	;; Pops the top item from the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
07F3:         	pop_stack:
07F3: 2A940D  	    LD      HL, (STACK_BASE)
07F6: ED5B960D	    LD      DE, (STACK_POINTER)
07FA: ED52    	    SBC     HL, DE
07FC: 201A    	    JR      NZ, pop_stack_execute
              	
              	    .local
07FE: 110608  	    LD      DE, ERROR
0801: 0E09    	    LD      C, $09
0803: C30500  	    JP      $0005
              	
0806: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
080A: 6B206973	
080E: 20656D70	
0812: 74792E5C	
0816: 6E24    	
              	    .endlocal
              	
0818:         	pop_stack_execute:
0818: 2A960D  	    LD      HL, (STACK_POINTER)
081B: 23      	    INC     HL                              ; skip the type
              	
081C: 4E23462B	    LD      BC, (HL)                        ; load the string length
0820: 23      	    INC     HL
0821: 23      	    INC     HL
              	
0822: 09      	    ADD     HL, BC                          ; calculate location after the string
              	
0823: 22960D  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
0826: C9      	    RET
              	    
              	    .include "stack/stack-concatenate.asm"
              	;; ===============================================================
              	;; Concatenates the two strings on the stack, replacing them with
              	;; the concatenation
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ===============================================================
0827:         	stack_concatenate:
0827: 2A940D  	    LD      HL, (STACK_BASE)
082A: ED5B960D	    LD      DE, (STACK_POINTER)
082E: ED52    	    SBC     HL, DE
0830: 201A    	    JR      NZ, stack_concatenate_execute
              	
              	    .local
0832: 113A08  	    LD      DE, ERROR
0835: 0E09    	    LD      C, $09
0837: C30500  	    JP      $0005
              	
083A: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
083E: 6B206973	
0842: 20656D70	
0846: 74792E5C	
084A: 6E24    	
              	    .endlocal
              	
084C:         	stack_concatenate_execute:
084C: DD2A960D	    LD      IX, (STACK_POINTER)             ; second string
              	
0850: 2A960D  	    LD      HL, (STACK_POINTER)
0853: DD4E01  	    LD      BC, (IX + 1)                    ; string length
0856: DD4602  	
0859: 09      	    ADD     HL, BC
              	
085A: 010300  	    LD      BC, 0x0003                      ; header length
085D: 09      	    ADD     HL, BC
              	
085E: E5      	    PUSH    HL
085F: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
0861: ED5B960D	    LD      DE, (STACK_POINTER)
0865: 1B      	    DEC     DE
              	
              	; copy the second word
0866: DD4E01  	    LD      BC, (IX + 1)                    ; count
0869: DD4602  	
086C: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
086E: E1      	    POP     HL
086F: 09      	    ADD     HL, BC
0870: 23      	    INC     HL
0871: 23      	    INC     HL
              	
0872: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
0874: FD4E01  	    LD      BC, (IY + 1)                    ; count
0877: FD4602  	
