0B26: B7      	    OR      A
0B27: C0      	    RET     NZ                              ; error
              	
0B28:         	save_command_execute:
0B28:         	save_command_prepare_index:                 ; create index of word list entries
0B28: 2A5D0D  	    LD      HL, (WORD_LIST_NEXT)            ; start the index where the next new word would go
0B2B: 11630D  	    LD      DE, WORD_LIST_END               ; location of the end of the word list
0B2E: 7323722B	    LD      (HL), DE                        ; write this end address as the first entry in the index
              	
0B32: DD2A5B0D	    LD      IX, (WORD_LIST_HEAD)            ; start IX at the head of the word list
              	
0B36: DD7E00  	    LD      A, (IX)
0B39: B7      	    OR      A
0B3A: 201C    	    JR      NZ, save_command_prepare_index_loop
              	
              	    .local
0B3C: 11430B  	    LD      DE, MESSAGE
0B3F: CD2707  	    CALL    PRINT
0B42: C9      	    RET
              	
0B43: 576F7264	MESSAGE DEFM    "Word list is empty.", 10, 0
0B47: 206C6973	
0B4B: 74206973	
0B4F: 20656D70	
0B53: 74792E0A	
0B57: 00      	
              	    .endlocal
              	
0B58:         	save_command_prepare_index_loop:
0B58: DD7E00  	    LD      A, (IX + 0)                     ; load the length of the word
0B5B: B7      	    OR      A                               ; if 0, then end of word list reached
0B5C: 2814    	    JR      Z, save_command_prepare_index_done
              	
0B5E:         	save_command_prepare_index_write_address:
0B5E: DDE5    	    PUSH    IX                              ; copy the address of the word list entry into DE
0B60: D1      	    POP     DE
              	
0B61: 23      	    INC     HL
0B62: 23      	    INC     HL
0B63: 7323722B	    LD      (HL), DE                        ; write the address of the word list entry to the index
              	
0B67: DD5E01  	    LD      DE, (IX + 1)                    ; load the address of the next word list entry
0B6A: DD5602  	
0B6D: D5      	    PUSH    DE
0B6E: DDE1    	    POP     IX                              ; copy it to IX
              	
0B70: 18E6    	    JR      save_command_prepare_index_loop
              	
0B72:         	save_command_prepare_index_done:
              	; HL now points to the last address in the index, the starting point for the write loop
0B72: 54      	    LD      D, H                            ; Set DE to point to the address after the index where the file output will be prepared
0B73: 5D      	    LD      E, L
0B74: 13      	    INC     DE
0B75: 13      	    INC     DE
              	
0B76: D5      	    PUSH    DE                              ; save DE (start of prepared file)
              	
0B77:         	save_command_prepare_file_content_loop:
0B77: 4E23462B	    LD      BC, (HL)                        ; load the address of the word list entry
0B7B: DD60DD69	    LD      IX, BC
              	
0B7F: DD7E00  	    LD      A, (IX + 0)
0B82: B7      	    OR      A
0B83: 2819    	    JR      Z, save_command_prepare_file_content_done
              	
0B85: E5      	    PUSH    HL                              ; save HL
              	
0B86: DD6E03  	    LD      HL, (IX + 3)                    ; source address of the word, DE is the destination
0B89: DD6604  	
0B8C: 0600    	    LD      B, 0x00
0B8E: 4F      	    LD      C, A                            ; number of characters
              	
0B8F: EDB0    	    LDIR                                    ; copy the word
              	
0B91: 3E0D    	    LD      A, ASCII_CR                     ; append the CRLF
0B93: 12      	    LD      (DE), A
0B94: 13      	    INC     DE
0B95: 3E0A    	    LD      A, ASCII_LF
0B97: 12      	    LD      (DE), A
0B98: 13      	    INC     DE
              	
0B99: E1      	    POP     HL                              ; restore HL
              	
0B9A: 2B      	    DEC     HL                              ; back up to the previous index entry
0B9B: 2B      	    DEC     HL
0B9C: 18D9    	    JR      save_command_prepare_file_content_loop
              	
0B9E:         	save_command_prepare_file_content_done:
0B9E: 3E00    	    LD      A, 0x00                         ; append a null terminator
0BA0: 12      	    LD      (DE), A
              	
0BA1:         	save_command_save:
              	
0BA1: E1      	    POP     HL                              ; load HL with the start of the file content (previously pushed from DE)
              	
0BA2: CD4A03  	    CALL    save_file
              	
