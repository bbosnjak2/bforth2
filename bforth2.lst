0AF3: 218708  	    LD      HL, CURRENT_TOKEN               ; the word to find
0AF6: DD5E03  	    LD      E, (IX + 3)                     ; the current word
0AF9: DD5604  	    LD      D, (IX + 4)
              	
0AFC: 48      	    LD      C, B                            ; the number of characters
