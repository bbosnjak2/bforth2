0025:         	HELP_PROMPT_NL_LEN .equ    $ - HELP_PROMPT_NL
              	
              	    .endlocal
              	    
              	    .include "dictionary/INLINE.asm"
              	;; ==========================================================
              	;; Prompts the user to input a line of text.  The line is
              	;; stored in the CURRENT_INPUT buffer.
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
077F:         	INLINE:
077F: CDA607  	    CALL    PROMPT
