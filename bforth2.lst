              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
017B:         	fill_memory:
017B: 77      	    LD      (HL), A                         ; set the first location
017C: 0B      	    DEC     BC
              	
017D: 54      	    LD      D, H                            ; set the next location as the destination
017E: 5D      	    LD      E, L
017F: 13      	    INC     DE
              	
0180: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
0182: C9      	    RET
              	    
