              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
019D:         	fill_memory:
019D: 77      	    LD      (HL), A                         ; set the first location
019E: 0B      	    DEC     BC
              	
019F: 54      	    LD      D, H                            ; set the next location as the destination
01A0: 5D      	    LD      E, L
01A1: 13      	    INC     DE
              	
01A2: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
01A4: C9      	    RET
              	    
