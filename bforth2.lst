              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
0456:         	skip_whitespace:
0456:         	skip_whitespace_loop:
0456: 7E      	    LD      A, (HL)                         ; A contains the character
0457: B7      	    OR      A                               ; check for null terminator
0458: 2808    	    JR      Z, skip_whitespace_done
              	
045A: CD4B01  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
045D: 2003    	    JR      NZ, skip_whitespace_done
              	
045F: 23      	    INC     HL
0460: 18F4    	    JR      skip_whitespace_loop
              	
0462:         	skip_whitespace_done:
0462: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
0463:         	to_uppercase:
0463: E5      	    PUSH    HL                              ; cache the starting address
0464: C5      	    PUSH    BC                              ; cache the length
              	
0465:         	to_uppercase_loop:
0465: 78      	    LD      A, B
0466: B7      	    OR      A
0467: 2814    	    JR      Z, to_uppercase_done
              	
0469: 7E      	    LD      A, (HL)
              	
046A:         	to_uppercase_process_character:
046A: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
046C: 380B    	    JR      C, to_uppercase_next_character
              	
046E: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
0470: 3807    	    JR      C, to_uppercase_next_character
              	
0472: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
0474: 3003    	    JR      NC, to_uppercase_next_character
              	
0476: CBAF    	    RES     5, A                            ; uppercase the character
0478: 77      	    LD      (HL), A
              	
0479:         	to_uppercase_next_character:
0479: 23      	    INC     HL
047A: 05      	    DEC     B
047B: 18E8    	    JR      to_uppercase_loop
              	
047D:         	to_uppercase_done:
047D: C1      	    POP     BC                              ; restore the length
047E: E1      	    POP     HL                              ; restore the starting address
              	
047F: C9      	    RET
              	    
