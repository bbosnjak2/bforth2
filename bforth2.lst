              	    .include "system/system-fill-memory.asm"
              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
0975:         	system_fill_memory:
0975: 77      	    LD      (HL), A                         ; set the first location
0976: 0B      	    DEC     BC
              	
0977: 54      	    LD      D, H                            ; set the next location as the destination
0978: 5D      	    LD      E, L
0979: 13      	    INC     DE
              	
097A: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
097C: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
