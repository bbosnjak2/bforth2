091E: B7      	    OR      A                               ; if 0, then end of list reached
091F: 282B    	    JR      Z, find_command_method_address_not_found
              	
0921: B8      	    CP      B                               ; if the length differs, move to the next command
0922: 200E    	    JR      NZ, find_command_method_address_next_command
              	
0924:         	find_command_method_address_compare:
