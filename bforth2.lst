0973: 7E      	    LD      A, (HL)
              	
0974: CD5B01  	    CALL    is_whitespace
0977: 2006    	    JR      NZ, parse_token_copy_token_loop
              	
0979: 23      	    INC     HL
097A: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
097D: 18EE    	    JR      parse_token_skip_whitespace
              	
097F:         	parse_token_copy_token_loop:
097F: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
0980: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0983: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0984: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
0987: 2807    	    JR      Z, parse_token_end_of_token
              	
0989: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
098A: 7E      	    LD      A, (HL)                         ; load the next character
098B: CD5B01  	    CALL    is_whitespace
098E: 20EF    	    JR      NZ, parse_token_copy_token_loop
              	
0990:         	parse_token_end_of_input:
