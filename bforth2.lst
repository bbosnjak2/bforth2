              	;; ==========================================================
              	;; Resets the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
0789:         	RESET_STACK
0789: 210000  	    LD      HL, 0                           ; effectively load the SP value into HL
078C: 39      	    ADD     HL, SP                          ; SP is from top of memory
              	
078D: 010004  	    LD      BC, 0x0400                      ; allow 1K space for the stack
0790: ED42    	    SBC     HL, BC
              	
0792: 22A50D  	    LD      (STACK_BASE), HL
0795: 22A70D  	    LD      (STACK_POINTER), HL
              	
0798: C9      	    RET
              	    
