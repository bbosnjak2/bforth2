              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
08D4:         	system_fill_memory:
08D4: 77      	    LD      (HL), A                         ; set the first location
08D5: 0B      	    DEC     BC
              	
08D6: 54      	    LD      D, H                            ; set the next location as the destination
08D7: 5D      	    LD      E, L
08D8: 13      	    INC     DE
              	
08D9: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
08DB: C9      	    RET
              	    
