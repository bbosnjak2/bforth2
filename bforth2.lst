              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
08EF:         	process_current_input:
08EF: CD5009  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
08F2: 214D0E  	    LD      HL, CURRENT_TOKEN
08F5: 3A4C0E  	    LD      A, (CURRENT_TOKEN_LEN)
08F8: B7      	    OR      A
08F9: 2817    	    JR      Z, process_current_input_done
              	
08FB: 47      	    LD      B, A
08FC: CD7304  	    CALL    to_uppercase
              	
08FF: CD1309  	    CALL    find_command_method_address
              	
0902: 280D    	    JR      Z, process_current_input_command_recognized
              	
0904:         	process_current_input_command_not_recognized:
