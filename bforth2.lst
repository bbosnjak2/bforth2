08AB: DD4602  	
08AE: 09      	    ADD     HL, BC
              	
08AF: 010300  	    LD      BC, 0x0003                      ; header length
08B2: 09      	    ADD     HL, BC
              	
08B3: E5      	    PUSH    HL
08B4: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
08B6: ED5BA70D	    LD      DE, (STACK_POINTER)
08BA: 1B      	    DEC     DE
              	
              	; copy the second word
08BB: DD4E01  	    LD      BC, (IX + 1)                    ; count
08BE: DD4602  	
08C1: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
08C3: E1      	    POP     HL
08C4: 09      	    ADD     HL, BC
08C5: 23      	    INC     HL
08C6: 23      	    INC     HL
              	
08C7: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
08C9: FD4E01  	    LD      BC, (IY + 1)                    ; count
08CC: FD4602  	
08CF: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
08D1: E1      	    POP     HL
08D2: 09      	    ADD     HL, BC
08D3: 23      	    INC     HL
08D4: 23      	    INC     HL
              	
08D5: EDB8    	    LDDR                                    ; copy second word down
              	
08D7: 13      	    INC     DE                              ; point to the start of the new string
              	
08D8: DD6E01  	    LD      HL, (IX + 1)
08DB: DD6602  	
08DE: FD4E01  	    LD      BC, (IY + 1)
08E1: FD4602  	
08E4: 09      	    ADD     HL, BC
08E5: 444D    	    LD      BC, HL                          ; combined length
              	
08E7: D9      	    EXX
08E8: CD4808  	    CALL    pop_stack
08EB: CD4808  	    CALL    pop_stack
08EE: D9      	    EXX
              	
08EF: CD3208  	    CALL    push_string
              	
08F2: C9      	    RET
              	    
              	
