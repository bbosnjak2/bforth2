              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
08F4:         	print:
08F4: 1A      	    LD      A, (DE)
08F5: B7      	    OR      A
08F6: C8      	    RET     Z                               ; nothing to print
              	
08F7: 3E00    	    LD      A, $00                          ; null terminator
08F9: 62      	    LD      H, D                            ; copy the start address in HL
08FA: 6B      	    LD      L, E
              	
08FB:         	print_find_null_terminator_loop:
08FB: EDA1    	    CPI                                     ; compare (HL) to a null terminator
08FD: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
08FF: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0900: 3E24    	    LD      A, '$'
0902: 77      	    LD      (HL), A
              	
0903: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
0904: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0906: CD0500  	    CALL    $0005
              	
0909: E1      	    POP     HL                              ; restore HL and put the null terminator back
090A: 3E00    	    LD      A, $00
090C: 77      	    LD      (HL), A
              	
090D: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
