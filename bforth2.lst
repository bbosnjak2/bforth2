0927: DD6604  	
092A: 114D0E  	    LD      DE, CURRENT_TOKEN
092D: 48      	    LD      C, B                            ; number of characters
              	
092E:         	find_command_method_address_compare_loop:
092E: 1A      	    LD      A, (DE)
092F: BE      	    CP      (HL)
0930: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
0932:         	find_command_method_address_next_command:
