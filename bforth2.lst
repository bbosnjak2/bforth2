              	    .include "dictionary/TOKEN.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and pushing it to the stack.  If no token is found then the stack
              	;; entry will have zero length.
              	;; IN:  -
              	;; OUT: -
              	;; MOD:
              	;; ==================================================================
0860:         	TOKEN:
0860: DD21D20E	    LD      IX, CURRENT_INPUT_LEN
0864: FD21AF08	    LD      IY, CURRENT_TOKEN_LEN
              	
0868: 21B008  	    LD      HL, CURRENT_TOKEN
086B: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
086E: 3E00    	    LD      A, 0x00
0870: FD360000	    LD      (IY), 0x00
0874: CD7509  	    CALL    system_fill_memory
              	
0877: 2AD40E  	    LD      HL, (CURRENT_INPUT_POS)
087A: 11B008  	    LD      DE, CURRENT_TOKEN
              	
087D:         	TOKEN_skip_whitespace:
087D: DD7E01  	    LD      A, (IX + 1)                     ; CURRENT_INPUT_REMAINING_LEN
0880: B7      	    OR      A
0881: 281D    	    JR      Z, TOKEN_end_of_input
              	
0883: 7E      	    LD      A, (HL)
              	
0884: CD6201  	    CALL    is_whitespace
0887: 2006    	    JR      NZ, TOKEN_copy_token_loop
              	
0889: 23      	    INC     HL
088A: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
              	
088D: 18EE    	    JR      TOKEN_skip_whitespace
              	
088F:         	TOKEN_copy_token_loop:
088F: 12      	    LD      (DE), A                         ; CURRENT_TOKEN
0890: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0893: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0894: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
0897: 2807    	    JR      Z, TOKEN_end_of_token
              	
0899: 13      	    INC     DE                              ; CURRENT_TOKEN
              	
089A: 7E      	    LD      A, (HL)                         ; load the next character
089B: CD6201  	    CALL    is_whitespace
089E: 20EF    	    JR      NZ, TOKEN_copy_token_loop
              	
08A0:         	TOKEN_end_of_input:
08A0:         	TOKEN_end_of_token:
08A0: 22D40E  	    LD      (CURRENT_INPUT_POS), HL
              	
08A3:         	TOKEN_done:
08A3: FD4E00  	    LD      C, (IY)                         ; CURRENT_INPUT_LEN
08A6: 0600    	    LD      B, 0
08A8: 11B008  	    LD      DE, CURRENT_TOKEN
08AB: CD8F09  	    CALL    push_string
              	
08AE: C9      	    RET
              	
08AF: 00      	CURRENT_TOKEN_LEN DEFB    0
08B0: 00000000	CURRENT_TOKEN     DEFS    (CURRENT_INPUT_MAX_LEN), 0
08B4: 00...   	
              	    
              	    .include "dictionary/WELCOME-TEXT.asm"
