086F: FD3400  	    INC     (IY)                            ; CURRENT_TOKEN_LEN
              	
0872: 23      	    INC     HL                              ; CURRENT_INPUT_POS
0873: DD3501  	    DEC     (IX + 1)                        ; CURRENT_INPUT_REMAINING_LEN
