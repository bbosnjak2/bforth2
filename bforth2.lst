086F:         	WELCOME_TEXT
              	    .local
086F: 117908  	    LD      DE, TEXT_GREETING_NL
0872: 011300  	    LD      BC, TEXT_GREETING_NL_LEN
0875: CDFE08  	    CALL    push_string
              	
0878: C9      	    RET
              	
0879: 57656C63	TEXT_GREETING_NL     DEFM    "Welcome to bforth2", 10
087D: 6F6D6520	
0881: 746F2062	
0885: 666F7274	
