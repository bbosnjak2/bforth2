              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0729:         	clear_screen
0729: 113207  	    LD      DE, CLEAR_SCREEN_SEQ
072C: 0E09    	    LD      C, $09
072E: CD0500  	    CALL    $0005
              	
0731: C9      	    RET
              	
0732:         	CLEAR_SCREEN_SEQ    DEFL    $
0732: 1B      	    .byte   27
0733: 5B324A  	    .ascii  "[2J"
0736: 1B      	    .byte   27
0737: 5B48    	    .ascii  "[H"
0739: 24      	    .ascii  "$"
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
073A:         	print:
073A: 1A      	    LD      A, (DE)
073B: B7      	    OR      A
073C: C8      	    RET     Z                               ; nothing to print
              	
073D: 3E00    	    LD      A, $00                          ; null terminator
073F: 62      	    LD      H, D                            ; copy the start address in HL
0740: 6B      	    LD      L, E
              	
0741:         	print_find_null_terminator_loop:
0741: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0743: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
0745: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
0746: 3E24    	    LD      A, '$'
0748: 77      	    LD      (HL), A
              	
0749: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
074A: 0E09    	    LD      C, $09                          ; invoke the CPM print method
074C: CD0500  	    CALL    $0005
              	
074F: E1      	    POP     HL                              ; restore HL and put the null terminator back
0750: 3E00    	    LD      A, $00
0752: 77      	    LD      (HL), A
              	
0753: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
0754:         	print_char:
0754: 5F      	    LD      E, A
0755: 0E02    	    LD      C, F_CONSOLE_OUT
0757: CD0500  	    CALL    BDOS
              	
075A: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
              	;; ==========================================================
              	;; Outputs the input prompt
              	;; IN:  -
              	;; OUT: -
              	;; MOD: DE
              	;; ==========================================================
075B:         	prompt
075B: 115B01  	    LD      DE, INPUT_PROMPT_SP
075E: CD3A07  	    CALL    print
              	
0761: C9      	    RET
              	    
              	
              	    .include "input/clear-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0762:         	clear_input_buffer
0762: 21280C  	    LD      HL, INPUT_BUFFER
0765: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
0768: 3E00    	    LD      A, 0x00
              	
076A: CD8E01  	    CALL    fill_memory
              	
076D: C9      	    RET
              	    
              	    .include "input/load-input-buffer.cpm.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;;
              	;; NOTE:  "IN B, (PORT)" and "OUT (PORT), B" are valid
              	;; documented Z80 instructions, but even when enabled the
              	;; assembler rejects them as invalid. As a result, the input
              	;; character has to be shuffled to/from B.
              	;; ==========================================================
076E:         	load_input_buffer
076E: CD6207  	    CALL    clear_input_buffer
              	
0771: 11260C  	    LD      DE, INPUT_BUFFER_SIZE
0774: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0776: 12      	    LD      (DE), A
              	
0777: 0E0A    	    LD      C, $0A
0779: CD0500  	    CALL    $0005
              	
              	; echo a LF since BDOS doesn't
077C: 1E0A    	    LD      E, ASCII_LF
077E: 0E02    	    LD      C, $02
0780: CD0500  	    CALL    $0005
              	
0783: C9      	    RET
              	    
              	
              	    .include "input/copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input, with null
              	;; termination
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
0784:         	COPY_INPUT_TO_CURRENT_INPUT:
0784: 21280C  	    LD      HL, INPUT_BUFFER
0787: 11790C  	    LD      DE, CURRENT_INPUT
078A: 3A270C  	    LD      A, (INPUT_BUFFER_COUNT)
              	
078D: B7      	    OR      A                               ; skip if nothing was input
078E: 2805    	    JR      Z, COPY_INPUT_TO_CURRENT_INPUT_RESTORE_NULL
              	
0790: 0600    	    LD      B, 0                            ; load BC with the number of bytes that were input
0792: 4F      	    LD      C, A
              	
0793: EDB0    	    LDIR
              	
0795:         	COPY_INPUT_TO_CURRENT_INPUT_RESTORE_NULL:
0795: 3E00    	    LD      A, 0x00                         ; write terminating null
0797: 12      	    LD      (DE), A
              	
0798: C9      	    RET
              	    
              	
              	    .include "command-processor/process-current-input.asm"
              	;; ==================================================================
              	;; Parses the initial token in CURRENT_INPUT as the command and
              	;; executes it if identified otherwise returns.  The executed command
              	;; will also return.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
0799:         	process_current_input:
              	
0799: 21790C  	    LD      HL, CURRENT_INPUT
079C: 22CA0C  	    LD      (CURRENT_INPUT_POS), HL         ; initialize the position at the start
              	
079F: CDF507  	    CALL    parse_token                     ; parse command (copy to CURRENT_TOKEN, upper-case it, determine length)
              	
07A2: 21CC0C  	    LD      HL, CURRENT_TOKEN
07A5: CDAE04  	    CALL    to_uppercase
              	
07A8: CDBC07  	    CALL    find_command_method_address
              	
07AB: 280D    	    JR      Z, process_current_input_command_recognized
              	
07AD:         	process_current_input_command_not_recognized:
07AD: 11CC0C  	    LD      DE, CURRENT_TOKEN
07B0: CD3A07  	    CALL    print
07B3: 116201  	    LD      DE, INPUT_NOT_RECOGNIZED_NL
07B6: CD3A07  	    CALL    print
07B9: C9      	    RET
              	
07BA:         	process_current_input_command_recognized:
              	; execute command if found (JP (HL), target will RET)
07BA: E9      	    JP      HL
              	
07BB:         	process_current_input_done:
07BB: C9      	    RET
              	
              	    .include "find-command-method-address.asm"
              	;; ==================================================================
              	;; Finds the command in CURRENT_COMMAND in the command list.
              	;; IN:  B  = number of characters in the command
              	;; OUT: HL = address of command method
              	;;      Z = set if command found (NZ if not found)
              	;; MOD: A, C, HL, DE, IX
              	;; ==========================================================
07BC:         	find_command_method_address:
              	
07BC: DD21C704	    LD      IX, COMMAND_LIST
              	
07C0:         	find_command_method_address_check_command:
07C0: DD7E02  	    LD      A, (IX + COMMAND_KEYWORD_LEN)
07C3: B7      	    OR      A                               ; if 0, then end of list reached
07C4: 282B    	    JR      Z, find_command_method_address_not_found
              	
07C6: B8      	    CP      B                               ; if the length differs, move to the next command
07C7: 200E    	    JR      NZ, find_command_method_address_next_command
              	
07C9:         	find_command_method_address_compare:
07C9: DD6E03  	    LD      HL, (IX + COMMAND_KEYWORD)
07CC: DD6604  	
07CF: 11CC0C  	    LD      DE, CURRENT_TOKEN
07D2: 48      	    LD      C, B                            ; number of characters
              	
07D3:         	find_command_method_address_compare_loop:
07D3: 1A      	    LD      A, (DE)
07D4: BE      	    CP      (HL)
07D5: 280B    	    JR      Z, find_command_method_address_compare_next_character
              	
07D7:         	find_command_method_address_next_command:
07D7: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
07DA: DD6601  	
07DD: E5      	    PUSH    HL
07DE: DDE1    	    POP     IX
07E0: 18DE    	    JR      find_command_method_address_check_command
              	
07E2:         	find_command_method_address_compare_next_character:
07E2: 23      	    INC     HL
07E3: 13      	    INC     DE
07E4: 0D      	    DEC     C                               ; move to next character
07E5: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
07E7:         	find_command_method_address_found:          ; all characters have matched
07E7: DD6E09  	    LD      HL, (IX + COMMAND_METHOD_ADDRESS)
07EA: DD660A  	
07ED: 3E00    	    LD      A, $00
07EF: B7      	    OR      A                               ; clears the Z flag
07F0: C9      	    RET
              	
07F1:         	find_command_method_address_not_found:
07F1: 3E01    	    LD      A, $01
07F3: B7      	    OR      A                               ; sets the Z flag
              	
07F4: C9      	    RET
              	    
              	    
              	    .include "command-processor/parse-token.asm"
              	;; ==================================================================
              	;; Extracts the token in CURRENT_INPUT, skipping leading whitespace,
              	;; and copying it to the CURRENT_TOKEN, null-terminated.  The B
              	;; register contains the number of characters (i.e. excludes the null
              	;; terminator).
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-token
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==================================================================
07F5:         	parse_token:
              	
07F5: 2ACA0C  	    LD      HL, (CURRENT_INPUT_POS)
07F8: 11CC0C  	    LD      DE, CURRENT_TOKEN
07FB: 0600    	    LD      B, $00                          ; number of characters in the token
              	
07FD: CDA104  	    CALL    skip_whitespace
              	
0800:         	parse_token_copy_token_loop:
0800: 7E      	    LD      A, (HL)                         ; A contains the character
0801: B7      	    OR      A
0802: 280B    	    JR      Z, parse_token_end_of_input
              	
0804: CD9601  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0807: 2806    	    JR      Z, parse_token_end_of_token
              	
0809:         	parse_token_copy_character:
0809: 12      	    LD      (DE), A
              	
080A: 04      	    INC     B
080B: 23      	    INC     HL
080C: 13      	    INC     DE
              	
080D: 18F1    	    JR      parse_token_copy_token_loop
              	
080F:         	parse_token_end_of_input:
080F:         	parse_token_end_of_token:
080F: 3E00    	    LD      A, $00
0811: 12      	    LD      (DE), A                         ; add null terminator
              	
0812: CDA104  	    CALL    skip_whitespace                 ; advance the current input pos to the next non-whitespace character
0815: 22CA0C  	    LD      (CURRENT_INPUT_POS), HL
              	
0818:         	parse_token_done:
0818: C9      	    RET
              	    
              	    .include "command-processor/commands/help-command.asm"
              	;; ==================================================================
              	;; Displays help.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
0819:         	help_command:
0819: 117B01  	    LD      DE, NOT_IMPLEMENTED_NL
081C: C33A07  	    JP      print
              	
081F: 2ACA0C  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
0822: 7E      	    LD      A, (HL)
0823: B7      	    OR      A
0824: 2807    	    JR      Z, help_command_execute
              	
0826:         	help_command_syntax_error:
0826: 116B01  	    LD      DE, SYNTAX_ERROR_NL
0829: CD3A07  	    CALL    print
              	
082C: C9      	    RET
              	
082D:         	help_command_execute:
082D: DD21C704	    LD      IX, COMMAND_LIST
              	
0831:         	help_command_loop:
