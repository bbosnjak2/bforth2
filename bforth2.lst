              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
01A5:         	is_whitespace:
01A5: FE20    	    CP      A, ASCII_SPACE
01A7: C8      	    RET     Z
              	
01A8: FE09    	    CP      A, ASCII_TAB
01AA: C8      	    RET     Z
              	
01AB: FE0D    	    CP      A, ASCII_CR
01AD: C8      	    RET     Z
              	
01AE: FE0A    	    CP      A, ASCII_LF
01B0: C8      	    RET     Z
              	
01B1: FE0C    	    CP      A, ASCII_FF
01B3: C8      	    RET     Z
              	
01B4: FE0B    	    CP      A, ASCII_VT
01B6: C8      	    RET     Z
              	
01B7: C9      	    RET
              	    
