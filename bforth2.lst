0B9E: 20656D70	
0BA2: 74792E0A	
0BA6: 00      	
              	    .endlocal
              	
0BA7:         	save_command_prepare_index_loop:
0BA7: DD7E00  	    LD      A, (IX + 0)                     ; load the length of the word
0BAA: B7      	    OR      A                               ; if 0, then end of word list reached
0BAB: 2814    	    JR      Z, save_command_prepare_index_done
              	
0BAD:         	save_command_prepare_index_write_address:
0BAD: DDE5    	    PUSH    IX                              ; copy the address of the word list entry into DE
0BAF: D1      	    POP     DE
              	
0BB0: 23      	    INC     HL
0BB1: 23      	    INC     HL
0BB2: 7323722B	    LD      (HL), DE                        ; write the address of the word list entry to the index
              	
0BB6: DD5E01  	    LD      DE, (IX + 1)                    ; load the address of the next word list entry
0BB9: DD5602  	
0BBC: D5      	    PUSH    DE
0BBD: DDE1    	    POP     IX                              ; copy it to IX
              	
0BBF: 18E6    	    JR      save_command_prepare_index_loop
              	
0BC1:         	save_command_prepare_index_done:
              	; HL now points to the last address in the index, the starting point for the write loop
0BC1: 54      	    LD      D, H                            ; Set DE to point to the address after the index where the file output will be prepared
0BC2: 5D      	    LD      E, L
0BC3: 13      	    INC     DE
0BC4: 13      	    INC     DE
              	
0BC5: D5      	    PUSH    DE                              ; save DE (start of prepared file)
              	
0BC6:         	save_command_prepare_file_content_loop:
0BC6: 4E23462B	    LD      BC, (HL)                        ; load the address of the word list entry
0BCA: DD60DD69	    LD      IX, BC
              	
0BCE: DD7E00  	    LD      A, (IX + 0)
0BD1: B7      	    OR      A
0BD2: 2819    	    JR      Z, save_command_prepare_file_content_done
              	
0BD4: E5      	    PUSH    HL                              ; save HL
              	
0BD5: DD6E03  	    LD      HL, (IX + 3)                    ; source address of the word, DE is the destination
0BD8: DD6604  	
0BDB: 0600    	    LD      B, 0x00
0BDD: 4F      	    LD      C, A                            ; number of characters
              	
0BDE: EDB0    	    LDIR                                    ; copy the word
              	
0BE0: 3E0D    	    LD      A, ASCII_CR                     ; append the CRLF
0BE2: 12      	    LD      (DE), A
0BE3: 13      	    INC     DE
0BE4: 3E0A    	    LD      A, ASCII_LF
0BE6: 12      	    LD      (DE), A
0BE7: 13      	    INC     DE
              	
0BE8: E1      	    POP     HL                              ; restore HL
              	
0BE9: 2B      	    DEC     HL                              ; back up to the previous index entry
0BEA: 2B      	    DEC     HL
0BEB: 18D9    	    JR      save_command_prepare_file_content_loop
              	
0BED:         	save_command_prepare_file_content_done:
0BED: 3E00    	    LD      A, 0x00                         ; append a null terminator
0BEF: 12      	    LD      (DE), A
              	
