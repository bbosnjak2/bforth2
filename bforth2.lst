              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
094C:         	system_fill_memory:
094C: 77      	    LD      (HL), A                         ; set the first location
094D: 0B      	    DEC     BC
              	
094E: 54      	    LD      D, H                            ; set the next location as the destination
094F: 5D      	    LD      E, L
0950: 13      	    INC     DE
              	
0951: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
0953: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
