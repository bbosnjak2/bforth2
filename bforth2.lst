              	    .endlocal
              	    
              	    .include "dictionary/DOT.asm"
              	;; ==========================================================
              	;; Prints the string that is on the stack
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ==========================================================
06FC:         	DOT
06FC: 2AA50D  	    LD      HL, (STACK_BASE)
06FF: ED5BA70D	    LD      DE, (STACK_POINTER)
0703: ED52    	    SBC     HL, DE
0705: 201A    	    JR      NZ, DOT_push_terminator
              	
              	    .local
0707: 110F07  	    LD      DE, ERROR
070A: 0E09    	    LD      C, $09
070C: C30500  	    JP      $0005
              	
070F: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
0713: 6B206973	
0717: 20656D70	
071B: 74792E5C	
071F: 6E24    	
              	    .endlocal
              	
0721:         	DOT_push_terminator:
              	    .local
0721: 112C07  	    LD      DE, TERMINATOR                  ; content
0724: 010100  	    LD      BC, 0x01                        ; length
0727: CD3208  	    CALL    push_string
072A: 1801    	    JR      DOT_concatenate
              	
072C: 24      	TERMINATOR DEFM    "$"
              	    .endlocal
              	
072D:         	DOT_concatenate:
072D: CD7C08  	    CALL    stack_concatenate
              	
0730:         	DOT_print:
0730: ED5BA70D	    LD      DE, (STACK_POINTER)
0734: 13      	    INC     DE                              ; type byte
0735: 13      	    INC     DE                              ; length word
0736: 13      	    INC     DE
              	
0737: CD1B01  	    CALL    bdos_print_string
              	
073A: CD4808  	    CALL    pop_stack
              	
073D: C9      	    RET
              	    
              	    .include "dictionary/HELP-PROMPT-TEXT.asm"
