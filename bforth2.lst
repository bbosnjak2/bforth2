08A7: 201A    	    JR      NZ, dot_push_terminator
              	
              	    .local
08A9: 11B108  	    LD      DE, ERROR
08AC: 0E09    	    LD      C, $09
08AE: C30500  	    JP      $0005
              	
08B1: 53746163	ERROR      DEFM    "Stack is empty.\n", "$"
08B5: 6B206973	
08B9: 20656D70	
08BD: 74792E5C	
08C1: 6E24    	
              	    .endlocal
              	
08C3:         	dot_push_terminator:
