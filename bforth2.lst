              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
014D:         	fill_memory:
014D: 77      	    LD      (HL), A                         ; set the first location
014E: 0B      	    DEC     BC
              	
014F: 54      	    LD      D, H                            ; set the next location as the destination
0150: 5D      	    LD      E, L
0151: 13      	    INC     DE
              	
0152: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
0154: C9      	    RET
              	    
              	    .include "util/is-whitespace.asm"
              	
              	;; ===============================================================
              	;; Determines if the character in A is whitespace (NZ for false,
              	;; Z for true)
              	;; IN:  A  - character
              	;; OUT: Z flag
              	;; MOD: flags
              	;; ===============================================================
0155:         	is_whitespace:
0155: FE20    	    CP      A, ASCII_SPACE
0157: C8      	    RET     Z
              	
0158: FE09    	    CP      A, ASCII_TAB
015A: C8      	    RET     Z
              	
015B: FE0D    	    CP      A, ASCII_CR
015D: C8      	    RET     Z
              	
015E: FE0A    	    CP      A, ASCII_LF
0160: C8      	    RET     Z
              	
0161: FE0C    	    CP      A, ASCII_FF
0163: C8      	    RET     Z
              	
0164: FE0B    	    CP      A, ASCII_VT
0166: C8      	    RET     Z
              	
0167: C9      	    RET
              	    
