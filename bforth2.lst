              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
04A4:         	skip_whitespace:
04A4:         	skip_whitespace_loop:
04A4: 7E      	    LD      A, (HL)                         ; A contains the character
04A5: B7      	    OR      A                               ; check for null terminator
04A6: 2808    	    JR      Z, skip_whitespace_done
              	
04A8: CD9901  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
04AB: 2003    	    JR      NZ, skip_whitespace_done
              	
04AD: 23      	    INC     HL
04AE: 18F4    	    JR      skip_whitespace_loop
              	
04B0:         	skip_whitespace_done:
04B0: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
04B1:         	to_uppercase:
04B1: E5      	    PUSH    HL                              ; cache the starting address
04B2: C5      	    PUSH    BC                              ; cache the length
              	
04B3:         	to_uppercase_loop:
04B3: 78      	    LD      A, B
04B4: B7      	    OR      A
04B5: 2814    	    JR      Z, to_uppercase_done
              	
04B7: 7E      	    LD      A, (HL)
              	
04B8:         	to_uppercase_process_character:
04B8: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
04BA: 380B    	    JR      C, to_uppercase_next_character
              	
04BC: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
04BE: 3807    	    JR      C, to_uppercase_next_character
              	
04C0: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
04C2: 3003    	    JR      NC, to_uppercase_next_character
              	
04C4: CBAF    	    RES     5, A                            ; uppercase the character
04C6: 77      	    LD      (HL), A
              	
04C7:         	to_uppercase_next_character:
04C7: 23      	    INC     HL
04C8: 05      	    DEC     B
04C9: 18E8    	    JR      to_uppercase_loop
              	
04CB:         	to_uppercase_done:
04CB: C1      	    POP     BC                              ; restore the length
04CC: E1      	    POP     HL                              ; restore the starting address
              	
04CD: C9      	    RET
              	    
