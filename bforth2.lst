              	;; ==================================================================
              	;; Adds a word to the word list.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
0A80:         	add_command:
0A80: 114F01  	    LD      DE, NOT_IMPLEMENTED_NL
0A83: C3F408  	    JP      print
              	
              	;; CALL    parse_token
              	
0A86: 78      	    LD      A, B                            ; check if a word was specified
0A87: B7      	    OR      A
0A88: 283D    	    JR      Z, add_command_syntax_error
              	
0A8A: 2ADF0E  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
0A8D: 7E      	    LD      A, (HL)
0A8E: B7      	    OR      A
0A8F: 2036    	    JR      NZ, add_command_syntax_error
              	
0A91:         	add_command_write_word_text:
0A91: DD2A700F	    LD      IX, (WORD_LIST_NEXT)
              	
0A95: 78      	    LD      A, B                            ; write the number of characters (excludes the null terminator)
0A96: DD7700  	    LD      (IX + 0), A
              	
0A99: 2A6E0F  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
0A9C: DD7501  	    LD      (IX + 1), HL
0A9F: DD7402  	
              	
0AA2: C5      	    PUSH    BC                              ; save the number of characters value that's in B
              	
0AA3: 2A700F  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
0AA6: 110500  	    LD      DE, 5                           ; offset HL to the location to write the word itself
0AA9: 19      	    ADD     HL, DE
              	
0AAA: DD7503  	    LD      (IX + 3), HL                    ; update the header with the location where the text will be copied to
0AAD: DD7404  	
              	
0AB0: EB      	    EX      DE, HL                          ; update DE to be the destination pointed to by HL
0AB1: 218708  	    LD      HL, CURRENT_TOKEN               ; HL is the source
              	
0AB4: 48      	    LD      C, B
0AB5: 0600    	    LD      B, 0x00
0AB7: 03      	    INC     BC                              ; copy the null terminated, too
              	
0AB8: EDB0    	    LDIR                                    ; write the word, DE will be the new WORD_LIST_NEXT value
              	
0ABA: C1      	    POP     BC                              ; restore the number of characters value in B
              	
