              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
04B0:         	skip_whitespace:
04B0:         	skip_whitespace_loop:
04B0: 7E      	    LD      A, (HL)                         ; A contains the character
04B1: B7      	    OR      A                               ; check for null terminator
04B2: 2808    	    JR      Z, skip_whitespace_done
              	
04B4: CDA501  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
04B7: 2003    	    JR      NZ, skip_whitespace_done
              	
04B9: 23      	    INC     HL
04BA: 18F4    	    JR      skip_whitespace_loop
              	
04BC:         	skip_whitespace_done:
04BC: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
04BD:         	to_uppercase:
04BD: E5      	    PUSH    HL                              ; cache the starting address
04BE: C5      	    PUSH    BC                              ; cache the length
              	
04BF:         	to_uppercase_loop:
04BF: 78      	    LD      A, B
04C0: B7      	    OR      A
04C1: 2814    	    JR      Z, to_uppercase_done
              	
04C3: 7E      	    LD      A, (HL)
              	
04C4:         	to_uppercase_process_character:
04C4: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
04C6: 380B    	    JR      C, to_uppercase_next_character
              	
04C8: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
04CA: 3807    	    JR      C, to_uppercase_next_character
              	
04CC: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
04CE: 3003    	    JR      NC, to_uppercase_next_character
              	
04D0: CBAF    	    RES     5, A                            ; uppercase the character
04D2: 77      	    LD      (HL), A
              	
04D3:         	to_uppercase_next_character:
04D3: 23      	    INC     HL
04D4: 05      	    DEC     B
04D5: 18E8    	    JR      to_uppercase_loop
              	
