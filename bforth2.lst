085C: DD7E01  	    LD      A, (IX + 1)                     ; CURRENT_INPUT_REMAINING_LEN
085F: B7      	    OR      A
0860: 281D    	    JR      Z, parse_token_end_of_input
              	
0862: 7E      	    LD      A, (HL)
              	
