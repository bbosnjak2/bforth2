              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
0460:         	skip_whitespace:
0460:         	skip_whitespace_loop:
0460: 7E      	    LD      A, (HL)                         ; A contains the character
0461: B7      	    OR      A                               ; check for null terminator
0462: 2808    	    JR      Z, skip_whitespace_done
              	
0464: CD5501  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0467: 2003    	    JR      NZ, skip_whitespace_done
              	
0469: 23      	    INC     HL
046A: 18F4    	    JR      skip_whitespace_loop
              	
046C:         	skip_whitespace_done:
046C: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
046D:         	to_uppercase:
046D: E5      	    PUSH    HL                              ; cache the starting address
046E: C5      	    PUSH    BC                              ; cache the length
              	
046F:         	to_uppercase_loop:
046F: 78      	    LD      A, B
0470: B7      	    OR      A
0471: 2814    	    JR      Z, to_uppercase_done
              	
0473: 7E      	    LD      A, (HL)
              	
0474:         	to_uppercase_process_character:
0474: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
0476: 380B    	    JR      C, to_uppercase_next_character
              	
0478: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
047A: 3807    	    JR      C, to_uppercase_next_character
              	
047C: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
047E: 3003    	    JR      NC, to_uppercase_next_character
              	
0480: CBAF    	    RES     5, A                            ; uppercase the character
0482: 77      	    LD      (HL), A
              	
0483:         	to_uppercase_next_character:
0483: 23      	    INC     HL
0484: 05      	    DEC     B
0485: 18E8    	    JR      to_uppercase_loop
              	
0487:         	to_uppercase_done:
0487: C1      	    POP     BC                              ; restore the length
0488: E1      	    POP     HL                              ; restore the starting address
              	
0489: C9      	    RET
              	    
