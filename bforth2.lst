0847: 213C0D  	    LD      HL, CURRENT_TOKEN
084A: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
084D: 3E00    	    LD      A, 0x00
084F: FD360000	    LD      (IY), 0x00
0853: CD9101  	    CALL    fill_memory
              	
0856: 2A390D  	    LD      HL, (CURRENT_INPUT_POS)
0859: 113C0D  	    LD      DE, CURRENT_TOKEN
              	
