0AFE: BE      	    CP      (HL)
0AFF: 2007    	    JR      NZ, find_command_next_word
              	
0B01: 23      	    INC     HL
0B02: 13      	    INC     DE
              	
0B03: 05      	    DEC     B
0B04: 20F7    	    JR      NZ, find_command_loop_match_character
              	
0B06: 1812    	    JR      find_command_word_found
              	
0B08:         	find_command_next_word:
