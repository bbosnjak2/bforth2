              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
0463:         	skip_whitespace:
0463:         	skip_whitespace_loop:
0463: 7E      	    LD      A, (HL)                         ; A contains the character
0464: B7      	    OR      A                               ; check for null terminator
0465: 2808    	    JR      Z, skip_whitespace_done
              	
0467: CD5B01  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
046A: 2003    	    JR      NZ, skip_whitespace_done
              	
046C: 23      	    INC     HL
046D: 18F4    	    JR      skip_whitespace_loop
              	
046F:         	skip_whitespace_done:
046F: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
0470:         	to_uppercase:
0470: E5      	    PUSH    HL                              ; cache the starting address
0471: C5      	    PUSH    BC                              ; cache the length
              	
0472:         	to_uppercase_loop:
0472: 78      	    LD      A, B
0473: B7      	    OR      A
0474: 2814    	    JR      Z, to_uppercase_done
              	
0476: 7E      	    LD      A, (HL)
              	
0477:         	to_uppercase_process_character:
0477: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
0479: 380B    	    JR      C, to_uppercase_next_character
              	
047B: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
047D: 3807    	    JR      C, to_uppercase_next_character
              	
047F: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
0481: 3003    	    JR      NC, to_uppercase_next_character
              	
0483: CBAF    	    RES     5, A                            ; uppercase the character
0485: 77      	    LD      (HL), A
              	
0486:         	to_uppercase_next_character:
0486: 23      	    INC     HL
0487: 05      	    DEC     B
0488: 18E8    	    JR      to_uppercase_loop
              	
048A:         	to_uppercase_done:
048A: C1      	    POP     BC                              ; restore the length
048B: E1      	    POP     HL                              ; restore the starting address
              	
048C: C9      	    RET
              	    
