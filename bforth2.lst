              	    .endlocal
              	    
              	
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
07C0:         	print:
07C0: 1A      	    LD      A, (DE)
07C1: B7      	    OR      A
07C2: C8      	    RET     Z                               ; nothing to print
              	
07C3: 3E00    	    LD      A, $00                          ; null terminator
07C5: 62      	    LD      H, D                            ; copy the start address in HL
07C6: 6B      	    LD      L, E
              	
07C7:         	print_find_null_terminator_loop:
07C7: EDA1    	    CPI                                     ; compare (HL) to a null terminator
07C9: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
07CB: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
07CC: 3E24    	    LD      A, '$'
07CE: 77      	    LD      (HL), A
              	
07CF: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
07D0: 0E09    	    LD      C, $09                          ; invoke the CPM print method
07D2: CD0500  	    CALL    $0005
              	
07D5: E1      	    POP     HL                              ; restore HL and put the null terminator back
07D6: 3E00    	    LD      A, $00
07D8: 77      	    LD      (HL), A
              	
07D9: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
07DA:         	print_char:
07DA: 5F      	    LD      E, A
07DB: 0E02    	    LD      C, F_CONSOLE_OUT
07DD: CD0500  	    CALL    BDOS
              	
07E0: C9      	    RET
              	    
              	
              	    .include "system/system-clear-input-buffer.asm"
              	;; ==========================================================
              	;; Zeroes the input buffer
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07E1:         	system_clear_input_buffer
07E1: 21AB0D  	    LD      HL, INPUT_BUFFER
07E4: 015000  	    LD      BC, INPUT_BUFFER_MAX_LEN
07E7: 3E00    	    LD      A, 0x00
              	
07E9: CD1808  	    CALL    system_fill_memory
              	
07EC: C9      	    RET
              	    
              	    .include "system/system-copy-input-buffer-to-current-input.asm"
              	;; ==========================================================
              	;; Copies the input buffer to the current input
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, BC
              	;; ==========================================================
07ED:         	system_copy_input_to_current_input:
07ED: 21FC0D  	    LD      HL, CURRENT_INPUT
07F0: 015000  	    LD      BC, CURRENT_INPUT_MAX_LEN
07F3: 3E00    	    LD      A, 0x00
07F5: CD1808  	    CALL    system_fill_memory
              	
07F8: DD214C0E	    LD      IX, CURRENT_INPUT_LEN
              	
07FC: 21AB0D  	    LD      HL, INPUT_BUFFER                ; source
07FF: 11FC0D  	    LD      DE, CURRENT_INPUT               ; destination
0802: ED534E0E	    LD      (CURRENT_INPUT_POS), DE
              	
0806: 3AAA0D  	    LD      A, (INPUT_BUFFER_COUNT)         ; count
              	
0809: 0600    	    LD      B, 0x00
080B: 4F      	    LD      C, A
080C: DD7100  	    LD      (IX), C                         ; CURRENT_INPUT_LEN
080F: DD7101  	    LD      (IX+1), C                       ; CURRENT_INPUT_REMAINING_LEN
              	
0812: B7      	    OR      A                               ; skip if nothing was input
0813: 2802    	    JR      Z, system_copy_input_to_current_input_done
              	
0815: EDB0    	    LDIR                                    ; copy
              	
0817:         	system_copy_input_to_current_input_done:
0817: C9      	    RET
              	    
              	    .include "system/system-fill-memory.asm"
              	;; ===============================================================
              	;; Fills a block of memory with a byte
              	;; IN:  A  - byte
              	;;      HL - start address
              	;;      BC - number of bytes
              	;; OUT: HL - address of last byte filled
              	;;      DE - address of first byte following the last byte filled
              	;;      BC - 0x00
              	;; MOD: DE, HL, BC
              	;; ===============================================================
0818:         	system_fill_memory:
0818: 77      	    LD      (HL), A                         ; set the first location
0819: 0B      	    DEC     BC
              	
081A: 54      	    LD      D, H                            ; set the next location as the destination
081B: 5D      	    LD      E, L
081C: 13      	    INC     DE
              	
081D: EDB0    	    LDIR                                    ; fill location, increment address, decrement counter
              	
081F: C9      	    RET
              	    
              	    .include "system/system-load-input-buffer.asm"
              	;; ==========================================================
              	;; Loads the input buffer until CR is pressed or the buffer
              	;; is full.  clear_input_buffer is called first to clear the
              	;; buffer.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE
              	;; ==========================================================
0820:         	system_load_input_buffer
0820: CDE107  	    CALL    system_clear_input_buffer
              	
0823: 11A90D  	    LD      DE, INPUT_BUFFER_SIZE
0826: 3E50    	    LD      A, INPUT_BUFFER_MAX_LEN
0828: 12      	    LD      (DE), A
              	
0829: CD0F01  	    CALL    bdos_line_input
              	
              	; echo a LF since BDOS doesn't
082C: 1E0A    	    LD      E, ASCII_LF
082E: CD1501  	    CALL    bdos_print_char
              	
0831: C9      	    RET
              	    
              	
              	    .include "stack/data-types.asm"
0001:         	STACK_STRING_TYPE   .equ    0x01
              	    
              	    .include "stack/push-string.asm"
              	;; ==========================================================
              	;; Pushes a string to the stack
              	;; IN:  DE = address of string.  Can include embedded ASCII
              	;;           control characters and VT-52 codes.
              	;;      BC = number of characters
              	;; OUT:
              	;; MOD: HL, DE, BC
              	;; ==========================================================
0832:         	push_string:
0832: 2AA70D  	    LD      HL, (STACK_POINTER)
0835: ED42    	    SBC     HL, BC
              	
0837: 2B      	    DEC     HL                              ; 2 bytes for length
0838: 2B      	    DEC     HL
0839: 2B      	    DEC     HL                              ; 1 byte for type
              	
083A: 22A70D  	    LD      (STACK_POINTER), HL
              	
083D: 3601    	    LD      (HL), STACK_STRING_TYPE
083F: 23      	    INC     HL
              	
