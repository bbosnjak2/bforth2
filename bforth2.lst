0A7E: CD1507  	    CALL    DOT
              	
0A81: 11B70A  	    LD      DE, HELP_SYNTAX_DESCRIPTION_DELIMITER
0A84: 010300  	    LD      BC, HELP_SYNTAX_DESCRIPTION_DELIMITER_LEN
0A87: CD8F09  	    CALL    push_string
              	
0A8A: CD1507  	    CALL    DOT
0A8D: DDE1    	    POP     IX
              	
0A8F: DD5E07  	    LD      DE, (IX + COMMAND_DESCRIPTION)
0A92: DD5608  	
0A95: DD4E09  	    LD      BC, (IX + COMMAND_DESCRIPTION_LEN)
0A98: DD460A  	
0A9B: CD8F09  	    CALL    push_string
              	
0A9E: DDE5    	    PUSH    IX                              ; DOT uses IX
0AA0: CD1507  	    CALL    DOT
              	
0AA3: CD9007  	    CALL    NEWLINE
0AA6: DDE1    	    POP     IX
              	
0AA8:         	help_command_next_command:
0AA8: DD6E00  	    LD      HL, (IX + COMMAND_NEXT_COMMAND)
0AAB: DD6601  	
0AAE: E5      	    PUSH    HL
0AAF: DDE1    	    POP     IX
0AB1: 18B5    	    JR      help_command_loop
              	
0AB3:         	help_command_done:
0AB3: CD9E07  	    CALL    OK
              	
0AB6: C9      	    RET
              	
0AB7: 202D20  	HELP_SYNTAX_DESCRIPTION_DELIMITER     DEFM    " - "
0003:         	HELP_SYNTAX_DESCRIPTION_DELIMITER_LEN .equ    $ - HELP_SYNTAX_DESCRIPTION_DELIMITER
              	    .endlocal
              	    
              	    .include "command-processor/commands/add-command.asm"
              	;; ==================================================================
              	;; Adds a word to the word list.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
0ABA:         	add_command:
0ABA: CD2D08  	    CALL    STACK_EMPTY
0ABD: B7      	    OR      A
0ABE: C8      	    RET     Z
              	
0ABF: CDDC09  	    CALL    pop_string                      ; BC = length, HL = text
              	
0AC2:         	add_command_write_word_text:
0AC2: E5      	    PUSH    HL                              ; source text
              	
0AC3: DD2A650F	    LD      IX, (WORD_LIST_NEXT)
              	
0AC7: 79      	    LD      A, C                            ; write the number of characters (excludes the null terminator)
0AC8: DD7700  	    LD      (IX + 0), A
              	
0ACB: 2A630F  	    LD      HL, (WORD_LIST_HEAD)            ; write the new entry to point to the previous entry
0ACE: DD7501  	    LD      (IX + 1), HL
0AD1: DD7402  	
              	
0AD4: 2A650F  	    LD      HL, (WORD_LIST_NEXT)            ; location for the new word
0AD7: 110500  	    LD      DE, 5                           ; offset HL to the location to write the word itself
0ADA: 19      	    ADD     HL, DE
              	
0ADB: DD7503  	    LD      (IX + 3), HL                    ; update the header with the location where the text will be copied to
0ADE: DD7404  	
              	
0AE1: EB      	    EX      DE, HL                          ; update DE to be the destination pointed to by HL
0AE2: E1      	    POP     HL                              ; HL is the source, BC still contains the count
              	
0AE3: EDB0    	    LDIR                                    ; write the word, DE will be the new WORD_LIST_NEXT value
              	
0AE5:         	add_command_update_word_list_pointers:
0AE5: 2A650F  	    LD      HL, (WORD_LIST_NEXT)            ; the head is now what was previously the next location
0AE8: 22630F  	    LD      (WORD_LIST_HEAD), HL
0AEB: ED53650F	    LD      (WORD_LIST_NEXT), DE            ; the next location is now where DE ended up
              	
0AEF:         	add_command_done:
0AEF: CD9E07  	    CALL    OK
              	
0AF2: C9      	    RET
              	    
              	    .include "command-processor/commands/find-command.asm"
              	;; ==================================================================
              	;; Finds a word in the word list.
              	;; IN:  -
              	;; OUT: -
              	;; MOD: A, DE, HL, IX
              	;; ==================================================================
0AF3:         	find_command:
0AF3: CD2D08  	    CALL    STACK_EMPTY
0AF6: B7      	    OR      A
0AF7: C8      	    RET     Z
              	
0AF8: CDDC09  	    CALL    pop_string                      ; BC = length, HL = text
              	
0AFB:         	find_command_execute:
0AFB: DD2A630F	    LD      IX, (WORD_LIST_HEAD)
              	
0AFF:         	find_command_loop:
0AFF: DD7E00  	    LD      A, (IX + 0)                     ; load the length of the word
0B02: B7      	    OR      A                               ; if 0, then end of list reached
0B03: 2836    	    JR      Z, find_command_word_not_found
              	
0B05: B9      	    CP      C
0B06: 2012    	    JR      NZ, find_command_next_word      ; different length, so on to the next one
              	
0B08: DD5E03  	    LD      DE, (IX + 3)                    ; the current word
0B0B: DD5604  	
              	
0B0E: 41      	    LD      B, C                            ; length is 1 byte, copy to B for the comparison
              	
