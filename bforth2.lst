              	    .include "command-processor/commands/quit-command.asm"
              	;; ==================================================================
              	;; Signals that the app should end.  This is done by updating the
              	;; CURRENT_INPUT to be empty.
              	;; IN:  -
              	;; OUT: B  = number of characters
              	;;      HL = address of first non-COMMAND
              	;;           character in CURRENT_INPUT
              	;; MOD: A, B, DE, HL
              	;; ==========================================================
0E15:         	quit_command:
0E15: 2AD00E  	    LD      HL, (CURRENT_INPUT_POS)         ; check that no further input was specified
0E18: 7E      	    LD      A, (HL)
0E19: B7      	    OR      A
0E1A: 2807    	    JR      Z, quit_command_execute
              	
0E1C:         	quit_command_syntax_error:
0E1C: 113801  	    LD      DE, SYNTAX_ERROR_NL
0E1F: CD8C08  	    CALL    print
              	
0E22: C9      	    RET
              	
0E23:         	quit_command_execute:
0E23: E1      	    POP     HL                              ; pop the return address of the quit command
0E24: C31801  	    JP      main_done
              	    
              	
0E27:         	DATA_BASE                   DEFL    $
              	
0E27: 0000    	STACK_BASE                  DEFW    0
0E29: 0000    	STACK_POINTER               DEFW    0
              	
0050:         	INPUT_BUFFER_MAX_LEN        equ     80d
0E2B: 00      	INPUT_BUFFER_SIZE           DEFB    0
0E2C: 00      	INPUT_BUFFER_COUNT          DEFB    0
0E2D: 00000000	INPUT_BUFFER                DEFS    (CURRENT_INPUT_MAX_LEN + 1), 0 ; null-terminated
0E31: 00...   	
              	
0050:         	CURRENT_INPUT_MAX_LEN       equ     INPUT_BUFFER_MAX_LEN
0E7E: 00000000	CURRENT_INPUT               DEFS    (CURRENT_INPUT_MAX_LEN), 0
0E82: 00...   	
0ECE: 00      	CURRENT_INPUT_LEN           DEFB    0
0ECF: 00      	CURRENT_INPUT_REMAINING_LEN DEFB    0
0ED0: 0000    	CURRENT_INPUT_POS           DEFW    0
              	
0ED2: 00000000	PARSED_FILE_NAME            DEFS    8, 0
0ED6: 00000000	
0EDA: 000000  	PARSED_FILE_EXT             DEFS    3, 0
              	
0EDD: 00000000	LOAD_FILE_BUFFER            DEFS    128,0
0EE1: 00...   	
0F5D: 0000    	LOAD_FILE_BUFFER_POS        DEFW    0
              	
              	; this must be the last one:
0F5F: 670F    	WORD_LIST_HEAD:             DEFW    WORD_LIST_END   ; points to the last word added
0F61: 680F    	WORD_LIST_NEXT:             DEFW    WORD_LIST_END + 1 ; points to where the next new word will be stored
              	
              	; Structure:
              	;LENGTH: DEFB    3
              	;NEXT:   DEFW    WORD_LIST_END
              	;THIS:   DEFW    WORD
              	;WORD:   DEFM    "Abc", 0
              	
0F63: 0000    	WORD_LIST_CHECKPOINT_HEAD:  DEFW    0x0000
0F65: 0000    	WORD_LIST_CHECKPOINT_NEXT:  DEFW    0x0000
              	
0F67: 00      	WORD_LIST_END:              DEFB    0
              	    


