093D: 23      	    INC     HL
093E: 13      	    INC     DE
093F: 0D      	    DEC     C                               ; move to next character
0940: 20EC    	    JR      NZ, find_command_method_address_compare_loop
              	
0942:         	find_command_method_address_found:          ; all characters have matched
