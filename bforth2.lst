              	;; ==========================================================
              	;; Clears the screen
              	;; IN:  -
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
06EC:         	clear_screen
              	    .local
06EC: 11F906  	    LD      DE, CLEAR_SCREEN_SEQ            ; content
06EF: 010700  	    LD      BC, CLEAR_SCREEN_SEQ_LEN        ; length
06F2: CDDE07  	    CALL    push_string
              	
06F5: CD9F08  	    CALL    dot
              	
06F8: C9      	    RET
              	
06F9:         	CLEAR_SCREEN_SEQ     DEFL    $
06F9: 1B      	    .byte   27
06FA: 5B324A  	    .ascii  "[2J"
06FD: 1B      	    .byte   27
06FE: 5B48    	    .ascii  "[H"
              	
0007:         	CLEAR_SCREEN_SEQ_LEN .equ    $ - CLEAR_SCREEN_SEQ
              	    .endlocal
              	    
              	    .include "output/print.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  DE=address of null-terminated string.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, A, HL, DE
              	;; ==========================================================
0700:         	print:
0700: 1A      	    LD      A, (DE)
0701: B7      	    OR      A
0702: C8      	    RET     Z                               ; nothing to print
              	
0703: 3E00    	    LD      A, $00                          ; null terminator
0705: 62      	    LD      H, D                            ; copy the start address in HL
0706: 6B      	    LD      L, E
              	
0707:         	print_find_null_terminator_loop:
0707: EDA1    	    CPI                                     ; compare (HL) to a null terminator
0709: 20FC    	    JR      NZ, print_find_null_terminator_loop
              	
070B: 2B      	    DEC     HL                              ; replace the null with the CPM terminator
070C: 3E24    	    LD      A, '$'
070E: 77      	    LD      (HL), A
              	
070F: E5      	    PUSH    HL                              ; cache the address of the end of the string
              	
0710: 0E09    	    LD      C, $09                          ; invoke the CPM print method
0712: CD0500  	    CALL    $0005
              	
0715: E1      	    POP     HL                              ; restore HL and put the null terminator back
0716: 3E00    	    LD      A, $00
0718: 77      	    LD      (HL), A
              	
0719: C9      	    RET
              	    
              	    .include "output/print-char.cpm.asm"
              	;; ==========================================================
              	;; Types a null-terminated string
              	;; IN:  A - character.  Can include
              	;;      embedded ASCII control characters and VT-52 codes.
              	;; OUT: -
              	;; MOD: C, E
              	;; ==========================================================
071A:         	print_char:
071A: 5F      	    LD      E, A
071B: 0E02    	    LD      C, F_CONSOLE_OUT
071D: CD0500  	    CALL    BDOS
              	
0720: C9      	    RET
              	    
              	    .include "output/prompt.cpm.asm"
