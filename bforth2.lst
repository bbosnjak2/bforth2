045C: 7E      	    LD      A, (HL)                         ; A contains the character
045D: B7      	    OR      A                               ; check for null terminator
045E: 2808    	    JR      Z, skip_whitespace_done
              	
0460: CD5101  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0463: 2003    	    JR      NZ, skip_whitespace_done
              	
0465: 23      	    INC     HL
0466: 18F4    	    JR      skip_whitespace_loop
              	
0468:         	skip_whitespace_done:
0468: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
0469:         	to_uppercase:
0469: E5      	    PUSH    HL                              ; cache the starting address
046A: C5      	    PUSH    BC                              ; cache the length
              	
046B:         	to_uppercase_loop:
046B: 78      	    LD      A, B
046C: B7      	    OR      A
046D: 2814    	    JR      Z, to_uppercase_done
              	
046F: 7E      	    LD      A, (HL)
              	
0470:         	to_uppercase_process_character:
0470: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
0472: 380B    	    JR      C, to_uppercase_next_character
              	
0474: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
0476: 3807    	    JR      C, to_uppercase_next_character
              	
0478: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
047A: 3003    	    JR      NC, to_uppercase_next_character
              	
047C: CBAF    	    RES     5, A                            ; uppercase the character
047E: 77      	    LD      (HL), A
              	
047F:         	to_uppercase_next_character:
047F: 23      	    INC     HL
0480: 05      	    DEC     B
0481: 18E8    	    JR      to_uppercase_loop
              	
0483:         	to_uppercase_done:
0483: C1      	    POP     BC                              ; restore the length
0484: E1      	    POP     HL                              ; restore the starting address
              	
0485: C9      	    RET
              	    
