              	;; ===============================================================
              	;; Advances HL to the first non-whitespace character or a null
              	;; terminator
              	;; IN:  HL - starting address
              	;; OUT: HL - address of first non-whitespace character or a null
              	;;           terminator
              	;; MOD: A, HL, flags
              	;; ===============================================================
046A:         	skip_whitespace:
046A:         	skip_whitespace_loop:
046A: 7E      	    LD      A, (HL)                         ; A contains the character
046B: B7      	    OR      A                               ; check for null terminator
046C: 2808    	    JR      Z, skip_whitespace_done
              	
046E: CD6201  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
0471: 2003    	    JR      NZ, skip_whitespace_done
              	
0473: 23      	    INC     HL
0474: 18F4    	    JR      skip_whitespace_loop
              	
0476:         	skip_whitespace_done:
0476: C9      	    RET
              	    
              	    .include "util/to-uppercase.asm"
              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
0477:         	to_uppercase:
0477: E5      	    PUSH    HL                              ; cache the starting address
0478: C5      	    PUSH    BC                              ; cache the length
              	
0479:         	to_uppercase_loop:
0479: 78      	    LD      A, B
047A: B7      	    OR      A
047B: 2814    	    JR      Z, to_uppercase_done
              	
047D: 7E      	    LD      A, (HL)
              	
047E:         	to_uppercase_process_character:
047E: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
0480: 380B    	    JR      C, to_uppercase_next_character
              	
0482: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
0484: 3807    	    JR      C, to_uppercase_next_character
              	
0486: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
0488: 3003    	    JR      NC, to_uppercase_next_character
              	
048A: CBAF    	    RES     5, A                            ; uppercase the character
048C: 77      	    LD      (HL), A
              	
048D:         	to_uppercase_next_character:
048D: 23      	    INC     HL
048E: 05      	    DEC     B
048F: 18E8    	    JR      to_uppercase_loop
              	
0491:         	to_uppercase_done:
0491: C1      	    POP     BC                              ; restore the length
0492: E1      	    POP     HL                              ; restore the starting address
              	
0493: C9      	    RET
              	    
