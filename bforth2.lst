              	;; ===============================================================
              	;; Converts a string to uppercase in situ.
              	;; IN:  HL - start address
              	;;      B - length
              	;; OUT: HL - original start address
              	;;      B - original length
              	;; MOD:
              	;; ===============================================================
0473:         	to_uppercase:
0473: E5      	    PUSH    HL                              ; cache the starting address
0474: C5      	    PUSH    BC                              ; cache the length
              	
0475:         	to_uppercase_loop:
0475: 78      	    LD      A, B
0476: B7      	    OR      A
0477: 2814    	    JR      Z, to_uppercase_done
              	
0479: 7E      	    LD      A, (HL)
              	
047A:         	to_uppercase_process_character:
047A: FE20    	    CP      ASCII_FIRST_NON_CONTROL         ; first non-control character
047C: 380B    	    JR      C, to_uppercase_next_character
              	
047E: FE61    	    CP      ASCII_A_LOWER                   ; check if less than "a"
0480: 3807    	    JR      C, to_uppercase_next_character
              	
0482: FE7B    	    CP      ASCII_Z_LOWER_PLUS_ONE          ; check if greater than "z"
0484: 3003    	    JR      NC, to_uppercase_next_character
              	
0486: CBAF    	    RES     5, A                            ; uppercase the character
0488: 77      	    LD      (HL), A
              	
0489:         	to_uppercase_next_character:
0489: 23      	    INC     HL
048A: 05      	    DEC     B
048B: 18E8    	    JR      to_uppercase_loop
              	
048D:         	to_uppercase_done:
048D: C1      	    POP     BC                              ; restore the length
048E: E1      	    POP     HL                              ; restore the starting address
              	
048F: C9      	    RET
              	    
