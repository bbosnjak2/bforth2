              	;; MOD: A, HL, flags
              	;; ===============================================================
0466:         	skip_whitespace:
0466:         	skip_whitespace_loop:
0466: 7E      	    LD      A, (HL)                         ; A contains the character
0467: B7      	    OR      A                               ; check for null terminator
0468: 2808    	    JR      Z, skip_whitespace_done
              	
046A: CD5B01  	    CALL    is_whitespace                   ; check if this is a whitespace (Z for true)
046D: 2003    	    JR      NZ, skip_whitespace_done
              	
046F: 23      	    INC     HL
0470: 18F4    	    JR      skip_whitespace_loop
              	
0472:         	skip_whitespace_done:
0472: C9      	    RET
              	    
