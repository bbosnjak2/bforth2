087C: 22AB0D  	    LD      (STACK_POINTER), HL             ; update the stack pointer
              	
087F: C9      	    RET
              	    
              	    .include "stack/stack-concatenate.asm"
              	;; ===============================================================
              	;; Concatenates the two strings on the stack, replacing them with
              	;; the concatenation
              	;; IN:
              	;; OUT:
              	;; MOD:
              	;; ===============================================================
0880:         	stack_concatenate:
0880: 2AA90D  	    LD      HL, (STACK_BASE)
0883: ED5BAB0D	    LD      DE, (STACK_POINTER)
0887: ED52    	    SBC     HL, DE
0889: 201A    	    JR      NZ, stack_concatenate_execute
              	
              	    .local
088B: 119308  	    LD      DE, ERROR
088E: 0E09    	    LD      C, $09
0890: C30500  	    JP      $0005
              	
0893: 53746163	ERROR               DEFM    "Stack is empty.\n", "$"
0897: 6B206973	
089B: 20656D70	
089F: 74792E5C	
08A3: 6E24    	
              	    .endlocal
              	
08A5:         	stack_concatenate_execute:
08A5: DD2AAB0D	    LD      IX, (STACK_POINTER)             ; second string
              	
08A9: 2AAB0D  	    LD      HL, (STACK_POINTER)
08AC: DD4E01  	    LD      BC, (IX + 1)                    ; string length
08AF: DD4602  	
08B2: 09      	    ADD     HL, BC
              	
08B3: 010300  	    LD      BC, 0x0003                      ; header length
08B6: 09      	    ADD     HL, BC
              	
08B7: E5      	    PUSH    HL
08B8: FDE1    	    POP     IY                              ; first string
              	
              	; destination for new string (points to its end)
08BA: ED5BAB0D	    LD      DE, (STACK_POINTER)
08BE: 1B      	    DEC     DE
              	
              	; copy the second word
08BF: DD4E01  	    LD      BC, (IX + 1)                    ; count
08C2: DD4602  	
08C5: DDE5    	    PUSH    IX                              ; source: needs to point to the last character
08C7: E1      	    POP     HL
08C8: 09      	    ADD     HL, BC
08C9: 23      	    INC     HL
08CA: 23      	    INC     HL
              	
08CB: EDB8    	    LDDR                                    ; copy first word down.  DE is now the end location for the second word
              	
              	; destination: the DE from previous LDDR
08CD: FD4E01  	    LD      BC, (IY + 1)                    ; count
08D0: FD4602  	
08D3: FDE5    	    PUSH    IY                              ; source:  needs to point to the last character
08D5: E1      	    POP     HL
08D6: 09      	    ADD     HL, BC
08D7: 23      	    INC     HL
08D8: 23      	    INC     HL
              	
08D9: EDB8    	    LDDR                                    ; copy second word down
              	
08DB: 13      	    INC     DE                              ; point to the start of the new string
              	
08DC: DD6E01  	    LD      HL, (IX + 1)
08DF: DD6602  	
08E2: FD4E01  	    LD      BC, (IY + 1)
08E5: FD4602  	
08E8: 09      	    ADD     HL, BC
08E9: 444D    	    LD      BC, HL                          ; combined length
              	
08EB: D9      	    EXX
08EC: CD4C08  	    CALL    pop_stack
08EF: CD4C08  	    CALL    pop_stack
08F2: D9      	    EXX
              	
08F3: CD3608  	    CALL    push_string
              	
08F6: C9      	    RET
              	    
              	
